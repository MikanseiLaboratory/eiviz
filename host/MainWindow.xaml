<Window x:Class="Eiviz.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:Eiviz.Host.Preview"
        Title="eiviz" Height="980" Width="1680"
        Background="#1A1A1A" Foreground="#EEEEEE">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#252525" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mixing Unit" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="UnitBox" Width="280" SelectionChanged="UnitBox_SelectionChanged"/>
                    <Button Content="Add" Width="64" Margin="8,0,0,0" Click="AddUnit_Click"/>
                    <Button Content="Edit" Width="64" Margin="4,0,0,0" Click="EditUnit_Click"/>
                    <Button Content="Delete" Width="64" Margin="4,0,0,0" Click="DeleteUnit_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Save" Width="72" Click="SaveSession_Click"/>
                    <Button Content="Load" Width="72" Margin="8,0,0,0" Click="LoadSession_Click"/>
                    <Button Content="Overlay" Width="88" Margin="8,0,0,0" Click="OpenOverlay_Click"/>
                    <Button Content="Multiview" Width="96" Margin="8,0,0,0" Click="OpenMultiview_Click"/>
                    <Button Content="Settings" Width="96" Margin="8,0,0,0" Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#111" Padding="8,4">
            <DockPanel>
                <TextBlock x:Name="WarnText" DockPanel.Dock="Left" Foreground="#FFB74D" Margin="0,0,16,0" MinWidth="0"/>
                <TextBlock x:Name="ResourceText" DockPanel.Dock="Right" Foreground="#9CCC65" Margin="16,0,0,0"/>
                <TextBlock x:Name="StatusText" Foreground="#7CFC7C"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#161616" Padding="8,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Audio" FontWeight="Bold" Margin="0,0,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MeterPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#1C1C1C" Padding="8,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Overlay" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button DockPanel.Dock="Right" Content="Edit…" Width="64" Click="OpenOverlay_Click"/>
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="OverlayTogglePanel" VerticalAlignment="Center"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1.2*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#E87722" BorderThickness="2" Background="#111">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#E87722" Padding="8,4">
                            <TextBlock Text="PREVIEW" FontWeight="Bold" Foreground="#111"/>
                        </Border>
                        <preview:SwapchainHost x:Name="PreviewHost" OutputKind="1" UnitId="1"/>
                    </DockPanel>
                </Border>
                <DockPanel Grid.Column="1" Margin="8,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="+" Width="28" Click="AddTransition_Click"/>
                        <TextBlock Text="Transitions" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Slider x:Name="TBar" DockPanel.Dock="Bottom" Orientation="Horizontal" Minimum="0" Maximum="1"
                            Margin="0,8,0,0" Height="22" IsMoveToPointEnabled="True"
                            ValueChanged="TBar_ValueChanged"
                            PreviewMouseLeftButtonUp="TBar_MouseUp"
                            LostMouseCapture="TBar_LostMouseCapture"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TransitionPanel"/>
                    </ScrollViewer>
                </DockPanel>
                <Border Grid.Column="2" BorderBrush="#2E7D32" BorderThickness="2" Background="#111">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#2E7D32" Padding="8,4">
                            <TextBlock Text="PROGRAM" FontWeight="Bold"/>
                        </Border>
                        <preview:SwapchainHost x:Name="ProgramHost" OutputKind="0" UnitId="1"/>
                    </DockPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Inputs" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Button DockPanel.Dock="Bottom" Content="Add Input" Height="32" Click="AddInput_Click"/>
                    <ListBox x:Name="InputList" Background="#222" Foreground="#EEE" BorderBrush="#444"/>
                </DockPanel>
                <DockPanel Grid.Column="1" Margin="8,0,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="+" Width="28" Click="AddScene_Click"/>
                            <Button Content="-" Width="28" Margin="4,0,0,0" Click="RemoveScene_Click"/>
                            <Button Content="Edit" Width="48" Margin="4,0,0,0" Click="EditScene_Click"/>
                        </StackPanel>
                        <TextBlock Text="Scenes" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="ScenePanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
