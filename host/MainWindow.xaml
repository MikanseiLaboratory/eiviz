<Window x:Class="Eiviz.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:Eiviz.Host.Preview"
        xmlns:i18n="clr-namespace:Eiviz.Host.I18n"
        Title="{Binding [app.title], Source={x:Static i18n:Loc.Source}}" Height="980" Width="1680"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextForeground}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBackground}" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding [chrome.new], Source={x:Static i18n:Loc.Source}}" Width="64" Click="NewSession_Click"/>
                    <Button Content="{Binding [chrome.save], Source={x:Static i18n:Loc.Source}}" Width="72" Margin="8,0,0,0" Click="SaveSession_Click"/>
                    <Button Content="{Binding [chrome.load], Source={x:Static i18n:Loc.Source}}" Width="72" Margin="8,0,0,0" Click="LoadSession_Click"/>
                    <Button x:Name="OpenRecentButton" Content="▾" Width="22" Click="OpenRecent_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{Binding [chrome.mixingUnit], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="UnitBox" Width="280" SelectionChanged="UnitBox_SelectionChanged"/>
                    <Button Content="{Binding [chrome.add], Source={x:Static i18n:Loc.Source}}" Width="64" Margin="8,0,0,0" Click="AddUnit_Click"/>
                    <Button Content="{Binding [chrome.edit], Source={x:Static i18n:Loc.Source}}" Width="64" Margin="4,0,0,0" Click="EditUnit_Click"/>
                    <Button Content="{Binding [chrome.delete], Source={x:Static i18n:Loc.Source}}" Width="64" Margin="4,0,0,0" Click="DeleteUnit_Click"/>
                    <Button Content="{Binding [chrome.open], Source={x:Static i18n:Loc.Source}}" Width="64" Margin="4,0,0,0" Click="OpenSwitcher_Click"/>
                    <Button Content="{Binding [chrome.resources], Source={x:Static i18n:Loc.Source}}" Width="96" Margin="8,0,0,0" Click="Resources_Click"/>
                    <Button Content="{Binding [chrome.logs], Source={x:Static i18n:Loc.Source}}" Width="64" Margin="8,0,0,0" Click="Logs_Click"/>
                    <Button Content="{Binding [chrome.settings], Source={x:Static i18n:Loc.Source}}" Width="96" Margin="8,0,0,0" Click="Settings_Click"/>
                    <Button Content="{Binding [chrome.preferences], Source={x:Static i18n:Loc.Source}}" Width="96" Margin="8,0,0,0" Click="Preferences_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBackground}" Padding="8,4">
            <DockPanel>
                <TextBlock x:Name="ResourceText" DockPanel.Dock="Right" Foreground="{DynamicResource HudForeground}" Margin="16,0,0,0"
                           Cursor="Hand" MouseLeftButtonUp="ResourceHud_MouseUp"/>
                <TextBlock x:Name="WarnText" DockPanel.Dock="Right" Foreground="{DynamicResource WarnForeground}" Margin="0,0,12,0"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource StatusForeground}"/>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="140" MinHeight="80"/>
            </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160"/>
                <RowDefinition Height="1.2*" MinHeight="160"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                    <ColumnDefinition Width="260" MinWidth="220"/>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                </Grid.ColumnDefinitions>
                <preview:AspectBox x:Name="PreviewAspect" HeaderHeight="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,0,8,0">
                    <Border x:Name="PreviewFrame" BorderBrush="#00FF00" BorderThickness="2" Background="{DynamicResource VideoSurface}">
                        <DockPanel>
                            <Border x:Name="PreviewHeader" DockPanel.Dock="Top" Background="#00FF00" Padding="8,4">
                                <TextBlock x:Name="PreviewHeaderText" Text="{Binding [chrome.preview], Source={x:Static i18n:Loc.Source}}" FontWeight="Bold" Foreground="#111"/>
                            </Border>
                            <preview:SwapchainHost x:Name="PreviewHost" OutputKind="1" UnitId="1"/>
                        </DockPanel>
                    </Border>
                </preview:AspectBox>
                <GridSplitter Grid.Column="0" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="CurrentAndNext"
                              Background="{DynamicResource ButtonBorder}"/>
                <DockPanel Grid.Column="1" Margin="16,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="+" Width="28" Height="22" Click="AddTransition_Click"/>
                        <TextBlock Text="{Binding [chrome.transitions], Source={x:Static i18n:Loc.Source}}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Slider x:Name="TBar" DockPanel.Dock="Bottom" Orientation="Horizontal" Minimum="0" Maximum="1"
                            Width="220" HorizontalAlignment="Center" Margin="8,10,8,0" Height="18"
                            IsMoveToPointEnabled="True"
                            ValueChanged="TBar_ValueChanged"
                            PreviewMouseLeftButtonUp="TBar_MouseUp"
                            LostMouseCapture="TBar_LostMouseCapture"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TransitionPanel"/>
                    </ScrollViewer>
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="CurrentAndNext"
                              Background="{DynamicResource ButtonBorder}"/>
                <preview:AspectBox x:Name="ProgramAspect" Grid.Column="2" HeaderHeight="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="8,0,0,0">
                    <Border x:Name="ProgramFrame" BorderBrush="#FF0000" BorderThickness="2" Background="{DynamicResource VideoSurface}">
                        <DockPanel>
                            <Border x:Name="ProgramHeader" DockPanel.Dock="Top" Background="#FF0000" Padding="8,4">
                                <TextBlock x:Name="ProgramHeaderText" Text="{Binding [chrome.program], Source={x:Static i18n:Loc.Source}}" FontWeight="Bold"/>
                            </Border>
                            <preview:SwapchainHost x:Name="ProgramHost" OutputKind="0" UnitId="1"/>
                        </DockPanel>
                    </Border>
                </preview:AspectBox>
            </Grid>
            <GridSplitter Grid.Row="0" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                          ResizeDirection="Rows" ResizeBehavior="CurrentAndNext"
                          Background="{DynamicResource ButtonBorder}"/>
            <DockPanel Grid.Row="1">
                <Border x:Name="VideoBar" DockPanel.Dock="Bottom" Background="{DynamicResource VideoBarBackground}" Padding="8,6" Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock x:Name="VideoTitle" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="VideoTimeText" DockPanel.Dock="Top" FontSize="16" Margin="0,0,0,4"
                                   HorizontalAlignment="Center"/>
                        <Button x:Name="VideoPlay" DockPanel.Dock="Right" Width="44" Height="32" Margin="8,0,0,0"
                                Content="▶" Click="VideoPlay_Click"/>
                        <Button x:Name="VideoRestart" DockPanel.Dock="Right" Width="72" Height="32"
                                Content="Restart" Click="VideoRestart_Click"/>
                        <Slider x:Name="VideoSeek" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                IsMoveToPointEnabled="True"
                                ValueChanged="VideoSeek_ValueChanged"
                                PreviewMouseLeftButtonUp="VideoSeek_ClickSeek"
                                Thumb.DragStarted="VideoSeek_DragStarted"
                                Thumb.DragCompleted="VideoSeek_DragCompleted"/>
                    </DockPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" MinWidth="140"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding [chrome.inputs], Source={x:Static i18n:Loc.Source}}" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Grid DockPanel.Dock="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="{Binding [chrome.add], Source={x:Static i18n:Loc.Source}}" Height="32" Click="AddInput_Click"/>
                            <Button Grid.Column="2" Content="{Binding [chrome.edit], Source={x:Static i18n:Loc.Source}}" Height="32" Click="EditInput_Click"/>
                            <Button Grid.Column="4" Content="{Binding [chrome.previewInput], Source={x:Static i18n:Loc.Source}}" Height="32" Click="PreviewInput_Click"/>
                            <Button Grid.Column="6" Content="{Binding [chrome.delete], Source={x:Static i18n:Loc.Source}}" Height="32" Click="RemoveInput_Click"/>
                        </Grid>
                        <ListBox x:Name="InputList" Background="{DynamicResource ListBackground}" Foreground="{DynamicResource TextForeground}" BorderBrush="{DynamicResource ButtonBorder}"
                                 SelectionChanged="InputList_SelectionChanged"
                                 MouseDoubleClick="InputList_DoubleClick"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="0" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                  ResizeDirection="Columns" ResizeBehavior="CurrentAndNext"
                                  Background="{DynamicResource ButtonBorder}"/>
                    <DockPanel Grid.Column="1" Margin="8,0,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="+" Width="28" Click="AddScene_Click"/>
                                <Button Content="-" Width="28" Margin="4,0,0,0" Click="RemoveScene_Click"/>
                                <Button Content="Edit" Width="48" Margin="4,0,0,0" Click="EditScene_Click"/>
                            </StackPanel>
                            <TextBlock Text="{Binding [chrome.scenes], Source={x:Static i18n:Loc.Source}}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="ScenePanel"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Grid>
            <GridSplitter Grid.Row="0" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                          ResizeDirection="Rows" ResizeBehavior="CurrentAndNext"
                          Background="{DynamicResource ButtonBorder}"/>
            <Border Grid.Row="1" Background="{DynamicResource PanelBackground}" Padding="8,6">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="{Binding [chrome.audio], Source={x:Static i18n:Loc.Source}}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="MultiviewButton" Content="{Binding [chrome.multiview], Source={x:Static i18n:Loc.Source}}"
                                Width="96" Height="28" Margin="8,0,8,0" Click="OpenMultiview_Click"/>
                        <Button Content="{Binding [chrome.overlay], Source={x:Static i18n:Loc.Source}}"
                                Width="88" Height="28" Click="OpenOverlay_Click"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="80"/>
                            <ColumnDefinition Width="280" MinWidth="80"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="MeterPanel" Orientation="Horizontal"/>
                        </ScrollViewer>
                        <GridSplitter Grid.Column="0" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                      ResizeDirection="Columns" ResizeBehavior="CurrentAndNext"
                                      Background="{DynamicResource ButtonBorder}"/>
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="OverlayTogglePanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
