<Window x:Class="Eiviz.Host.Dialogs.SwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:Eiviz.Host.Preview"
        Title="Switcher" Height="640" Width="1280"
        Background="#1A1A1A" Foreground="#EEEEEE">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#252525" Padding="8,6">
            <TextBlock x:Name="TitleText" Text="Switcher" FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <preview:AspectBox x:Name="PreviewAspect" HeaderHeight="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,0,8,0">
                    <Border x:Name="PreviewFrame" BorderBrush="#00FF00" BorderThickness="2" Background="#000">
                        <DockPanel>
                            <Border x:Name="PreviewHeader" DockPanel.Dock="Top" Background="#00FF00" Padding="8,4">
                                <TextBlock x:Name="PreviewHeaderText" Text="PREVIEW" FontWeight="Bold" Foreground="#111"/>
                            </Border>
                            <preview:SwapchainHost x:Name="PreviewHost" OutputKind="1" UnitId="1"/>
                        </DockPanel>
                    </Border>
                </preview:AspectBox>
                <DockPanel Grid.Column="1" Margin="16,0">
                    <TextBlock DockPanel.Dock="Top" Text="Transitions" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Slider x:Name="TBar" DockPanel.Dock="Bottom" Orientation="Horizontal" Minimum="0" Maximum="1"
                            Width="220" HorizontalAlignment="Center" Margin="8,10,8,0" Height="18"
                            IsMoveToPointEnabled="True"
                            ValueChanged="TBar_ValueChanged"
                            PreviewMouseLeftButtonUp="TBar_MouseUp"
                            LostMouseCapture="TBar_LostMouseCapture"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TransitionPanel"/>
                    </ScrollViewer>
                </DockPanel>
                <preview:AspectBox x:Name="ProgramAspect" Grid.Column="2" HeaderHeight="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="8,0,0,0">
                    <Border x:Name="ProgramFrame" BorderBrush="#FF0000" BorderThickness="2" Background="#000">
                        <DockPanel>
                            <Border x:Name="ProgramHeader" DockPanel.Dock="Top" Background="#FF0000" Padding="8,4">
                                <TextBlock x:Name="ProgramHeaderText" Text="PROGRAM" FontWeight="Bold"/>
                            </Border>
                            <preview:SwapchainHost x:Name="ProgramHost" OutputKind="0" UnitId="1"/>
                        </DockPanel>
                    </Border>
                </preview:AspectBox>
            </Grid>
            <DockPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Top" Text="Scenes" FontWeight="Bold" Margin="0,0,0,6"/>
                <ListBox x:Name="SceneList" Background="#222" Foreground="#EEE" BorderBrush="#444"
                         MouseDoubleClick="SceneList_Activate"
                         SelectionChanged="SceneList_SelectionChanged"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
