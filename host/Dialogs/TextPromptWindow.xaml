<Window x:Class="Eiviz.Host.Dialogs.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name" Height="168" Width="360"
        WindowStartupLocation="CenterOwner"
        Background="#2B2B2B" Foreground="#EEEEEE"
        ResizeMode="NoResize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="88" Height="28" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="88" Height="28" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="PromptText" Text="Name" Margin="0,0,0,8"/>
            <TextBox x:Name="ValueBox"/>
        </StackPanel>
    </DockPanel>
</Window>
