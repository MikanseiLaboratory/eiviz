<Window x:Class="Eiviz.Host.Dialogs.InputPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:Eiviz.Host.Preview"
        Title="Input" Height="580" Width="960"
        Background="#111" Foreground="#EEEEEE"
        PreviewKeyDown="Window_KeyDown"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="Chrome" Background="#252525" Padding="8,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Fullscreen" Width="88" Click="Fullscreen_Click"/>
                <TextBlock x:Name="TitleText" Text="Input" VerticalAlignment="Center" FontWeight="Bold"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Background="#111">
            <preview:AspectBox x:Name="VideoAspect" RatioWidth="16" RatioHeight="9"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                <preview:ThumbView x:Name="PreviewHost"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </preview:AspectBox>
        </Grid>
    </Grid>
</Window>
