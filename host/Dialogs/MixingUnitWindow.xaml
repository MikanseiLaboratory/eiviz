<Window x:Class="Eiviz.Host.Dialogs.MixingUnitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mixing Unit" Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#2B2B2B" Foreground="#EEEEEE">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Name" VerticalAlignment="Center"/>
        <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="Width" VerticalAlignment="Center"/>
        <TextBox x:Name="WidthBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="1920"/>
        <TextBlock Grid.Row="2" Text="Height" VerticalAlignment="Center"/>
        <TextBox x:Name="HeightBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="1080"/>
        <TextBlock Grid.Row="3" Text="Frame rate" VerticalAlignment="Center"/>
        <ComboBox x:Name="FpsBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
            <ComboBoxItem Content="59.94p" Tag="60000/1001" IsSelected="True"/>
            <ComboBoxItem Content="50p" Tag="50/1"/>
            <ComboBoxItem Content="30p" Tag="30/1"/>
            <ComboBoxItem Content="24p" Tag="24/1"/>
            <ComboBoxItem Content="60p" Tag="60/1"/>
        </ComboBox>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="88" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="88" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
