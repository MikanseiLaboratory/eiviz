<Window x:Class="Eiviz.Host.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:Eiviz.Host.I18n"
        Title="{Binding [settings.title], Source={x:Static i18n:Loc.Source}}" Height="560" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackground}" Foreground="{DynamicResource TextForeground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource DialogSideBackground}">
            <ListBox x:Name="CategoryList" Background="Transparent" Foreground="{DynamicResource TextForeground}" BorderThickness="0"
                     SelectionChanged="CategoryList_SelectionChanged">
                <ListBoxItem Content="{Binding [settings.display], Source={x:Static i18n:Loc.Source}}" IsSelected="True"/>
                <ListBoxItem Content="{Binding [settings.performance], Source={x:Static i18n:Loc.Source}}"/>
                <ListBoxItem Content="{Binding [settings.outputs], Source={x:Static i18n:Loc.Source}}"/>
                <ListBoxItem Content="{Binding [settings.multiview], Source={x:Static i18n:Loc.Source}}"/>
                <ListBoxItem Content="{Binding [settings.audioAux], Source={x:Static i18n:Loc.Source}}"/>
                <ListBoxItem Content="{Binding [settings.advanced], Source={x:Static i18n:Loc.Source}}"/>
                <ListBoxItem Content="{Binding [settings.webApi], Source={x:Static i18n:Loc.Source}}"/>
            </ListBox>
        </Border>
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16">
                <Button Content="{Binding [dialog.default], Source={x:Static i18n:Loc.Source}}" Width="88" Click="Default_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Width="280">
                    <Button Content="{Binding [dialog.ok], Source={x:Static i18n:Loc.Source}}" Width="88" IsDefault="True" Click="Ok_Click"/>
                    <Button Content="{Binding [dialog.cancel], Source={x:Static i18n:Loc.Source}}" Width="88" Margin="8,0,0,0" IsCancel="True"/>
                </StackPanel>
            </StackPanel>
            <ScrollViewer x:Name="DisplayPanel" Margin="20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding [settings.previewColor], Source={x:Static i18n:Loc.Source}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <Border x:Name="PreviewColorSwatch" Width="48" Height="24" BorderBrush="#666" BorderThickness="1"/>
                    <Button Content="{Binding [settings.change], Source={x:Static i18n:Loc.Source}}" Width="72" Height="24" Margin="8,0,0,0" Click="PickPreviewColor_Click"/>
                </StackPanel>
                <TextBlock Text="{Binding [settings.programColor], Source={x:Static i18n:Loc.Source}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <Border x:Name="ProgramColorSwatch" Width="48" Height="24" BorderBrush="#666" BorderThickness="1"/>
                    <Button Content="{Binding [settings.change], Source={x:Static i18n:Loc.Source}}" Width="72" Height="24" Margin="8,0,0,0" Click="PickProgramColor_Click"/>
                </StackPanel>
                <TextBlock Text="{Binding [settings.inactiveColor], Source={x:Static i18n:Loc.Source}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <Border x:Name="InactiveColorSwatch" Width="48" Height="24" BorderBrush="#666" BorderThickness="1"/>
                    <Button Content="{Binding [settings.change], Source={x:Static i18n:Loc.Source}}" Width="72" Height="24" Margin="8,0,0,0" Click="PickInactiveColor_Click"/>
                </StackPanel>
                <TextBlock Text="{Binding [settings.masterFps], Source={x:Static i18n:Loc.Source}}"/>
                <ComboBox x:Name="FpsBox" Margin="0,4,0,12" Width="220" HorizontalAlignment="Left">
                    <ComboBoxItem Content="NTSC 59.94p" Tag="60000/1001" IsSelected="True"/>
                    <ComboBoxItem Content="50p" Tag="50/1"/>
                    <ComboBoxItem Content="30p" Tag="30/1"/>
                    <ComboBoxItem Content="24p" Tag="24/1"/>
                    <ComboBoxItem Content="60p" Tag="60/1"/>
                </ComboBox>
                <TextBlock Text="{Binding [settings.defaultUnitSize], Source={x:Static i18n:Loc.Source}}"/>
                <ComboBox x:Name="SizeBox" Margin="0,4,0,12" Width="220" HorizontalAlignment="Left">
                    <ComboBoxItem Content="1920x1080" Tag="1920x1080" IsSelected="True"/>
                    <ComboBoxItem Content="1280x720" Tag="1280x720"/>
                    <ComboBoxItem Content="3840x2160" Tag="3840x2160"/>
                </ComboBox>
                <TextBlock Text="{Binding [settings.frameBuffer], Source={x:Static i18n:Loc.Source}}"/>
                <ComboBox x:Name="BufferBox" Margin="0,4,0,12" Width="220" HorizontalAlignment="Left">
                    <ComboBoxItem Content="1" Tag="1"/>
                    <ComboBoxItem Content="2" Tag="2"/>
                    <ComboBoxItem Content="3" Tag="3" IsSelected="True"/>
                    <ComboBoxItem Content="4" Tag="4"/>
                    <ComboBoxItem Content="6" Tag="6"/>
                    <ComboBoxItem Content="8" Tag="8"/>
                </ComboBox>
                <TextBlock Text="{Binding [settings.colorFormat], Source={x:Static i18n:Loc.Source}}"/>
                <ComboBox x:Name="ColorFormatBox" Margin="0,4,0,12" Width="220" HorizontalAlignment="Left">
                    <ComboBoxItem Content="UYVY 4:2:2 (recommended)" Tag="uyvy" IsSelected="True"/>
                    <ComboBoxItem Content="BGRA 8-bit 4:4:4" Tag="bgra"/>
                </ComboBox>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DimForeground}"
                           Text="{Binding [settings.displayHelp], Source={x:Static i18n:Loc.Source}}"/>
            </StackPanel>
            </ScrollViewer>
            <StackPanel x:Name="PerformancePanel" Margin="20" Visibility="Collapsed">
                <TextBlock Text="{Binding [settings.adapter], Source={x:Static i18n:Loc.Source}}" FontWeight="Bold"/>
                <TextBlock x:Name="AdapterName" Margin="0,4,0,12" Text="—"/>
                <TextBlock Text="{Binding [settings.rebar], Source={x:Static i18n:Loc.Source}}"/>
                <TextBlock x:Name="RebarStatus" Margin="0,4,0,12" Text="—"/>
                <TextBlock Text="{Binding [settings.rebarMemory], Source={x:Static i18n:Loc.Source}}"/>
                <TextBlock x:Name="RebarMemory" Margin="0,4,0,12" Text="—"/>
                <CheckBox x:Name="RebarOptBox" Content="{Binding [settings.useRebar], Source={x:Static i18n:Loc.Source}}" Margin="0,0,0,12"
                          Foreground="{DynamicResource TextForeground}"/>
                <CheckBox x:Name="NdiGpuBox" Content="{Binding [settings.ndiGpu], Source={x:Static i18n:Loc.Source}}" Margin="0,0,0,12"
                          Foreground="{DynamicResource TextForeground}"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DimForeground}"
                           Text="{Binding [settings.perfHelp], Source={x:Static i18n:Loc.Source}}"/>
            </StackPanel>
            <DockPanel x:Name="OutputPanel" Margin="20" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="+" Width="28" Click="AddOutput_Click"/>
                    <TextBlock Text="{Binding [settings.outputs], Source={x:Static i18n:Loc.Source}}" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource DimForeground}" Margin="0,0,0,8"
                           Text="{Binding [settings.outputsHelp], Source={x:Static i18n:Loc.Source}}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="OutputRows"/>
                </ScrollViewer>
            </DockPanel>
            <StackPanel x:Name="MultiviewPanel" Margin="20" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="+" Width="28" Click="AddMv_Click"/>
                    <TextBlock Text="{Binding [settings.multiviews], Source={x:Static i18n:Loc.Source}}" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="MvList" Height="140" Background="{DynamicResource ListBackground}" Foreground="{DynamicResource TextForeground}" BorderBrush="{DynamicResource ButtonBorder}"
                         DisplayMemberPath="Name"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                    <Button Content="{Binding [chrome.open], Source={x:Static i18n:Loc.Source}}" Width="88" Click="OpenMv_Click"/>
                    <Button Content="{Binding [settings.layout], Source={x:Static i18n:Loc.Source}}" Width="88" Margin="8,0,0,0" Click="EditLayoutTiles_Click"/>
                    <Button Content="{Binding [chrome.delete], Source={x:Static i18n:Loc.Source}}" Width="88" Margin="8,0,0,0" Click="DeleteMv_Click"/>
                </StackPanel>
                <TextBlock Text="{Binding [settings.defaultMvUnit], Source={x:Static i18n:Loc.Source}}"/>
                <ComboBox x:Name="MvUnitBox" Margin="0,4,0,12" Width="280" HorizontalAlignment="Left"
                          DisplayMemberPath="Name"/>
                <TextBlock Text="{Binding [settings.projectRefresh], Source={x:Static i18n:Loc.Source}}"/>
                <ComboBox x:Name="MvPresentBox" Margin="0,4,0,12" Width="280" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Every frame" Tag="1"/>
                    <ComboBoxItem Content="Every 2 frames" Tag="2"/>
                    <ComboBoxItem Content="Every 3 frames" Tag="3" IsSelected="True"/>
                    <ComboBoxItem Content="Every 4 frames" Tag="4"/>
                    <ComboBoxItem Content="Every 6 frames" Tag="6"/>
                    <ComboBoxItem Content="Every 8 frames" Tag="8"/>
                </ComboBox>
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DimForeground}"
                           Text="{Binding [settings.mvHelp], Source={x:Static i18n:Loc.Source}}"/>
            </StackPanel>
            <DockPanel x:Name="AudioBusPanel" Margin="20" Visibility="Collapsed">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="+" Width="28" Click="AddBus_Click"/>
                    <TextBlock Text="{Binding [settings.audioAux], Source={x:Static i18n:Loc.Source}}" FontWeight="Bold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource DimForeground}" Margin="0,0,0,8"
                           Text="{Binding [settings.audioHelp], Source={x:Static i18n:Loc.Source}}"/>
                <CheckBox x:Name="HeadphoneCopyBox" DockPanel.Dock="Top" Content="{Binding [settings.headphoneCopy], Source={x:Static i18n:Loc.Source}}"
                          Margin="0,0,0,8" Foreground="{DynamicResource TextForeground}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="BusRows"/>
                </ScrollViewer>
            </DockPanel>
            <StackPanel x:Name="AdvancedPanel" Margin="20" Visibility="Collapsed">
                <TextBlock Text="{Binding [settings.flipBudget], Source={x:Static i18n:Loc.Source}}"/>
                <ComboBox x:Name="FlipBudgetBox" Margin="0,4,0,8" Width="280" HorizontalAlignment="Left">
                    <ComboBoxItem Content="{Binding [settings.flipBudgetAuto], Source={x:Static i18n:Loc.Source}}" Tag="0"/>
                    <ComboBoxItem Content="4" Tag="4"/>
                    <ComboBoxItem Content="6" Tag="6"/>
                    <ComboBoxItem Content="8" Tag="8"/>
                    <ComboBoxItem Content="10" Tag="10"/>
                    <ComboBoxItem Content="12" Tag="12"/>
                    <ComboBoxItem Content="16" Tag="16"/>
                </ComboBox>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DimForeground}"
                           Text="{Binding [settings.flipBudgetHelp], Source={x:Static i18n:Loc.Source}}"/>
            </StackPanel>
            <StackPanel x:Name="WebApiPanel" Margin="20" Visibility="Collapsed">
                <CheckBox x:Name="WebApiEnabledBox" Content="{Binding [settings.webApiEnabled], Source={x:Static i18n:Loc.Source}}"
                          Margin="0,0,0,12" Foreground="{DynamicResource TextForeground}"/>
                <TextBlock Text="{Binding [settings.webApiPort], Source={x:Static i18n:Loc.Source}}"/>
                <TextBox x:Name="WebApiPortBox" Margin="0,4,0,12" Width="220" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding [settings.webApiUser], Source={x:Static i18n:Loc.Source}}"/>
                <TextBox x:Name="WebApiUserBox" Margin="0,4,0,12" Width="220" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding [settings.webApiPassword], Source={x:Static i18n:Loc.Source}}"/>
                <PasswordBox x:Name="WebApiPasswordBox" Margin="0,4,0,12" Width="220" HorizontalAlignment="Left"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DimForeground}"
                           Text="{Binding [settings.webApiHelp], Source={x:Static i18n:Loc.Source}}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
