<Window x:Class="Eiviz.Host.Dialogs.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:Eiviz.Host.I18n"
        Title="{Binding [prefs.title], Source={x:Static i18n:Loc.Source}}"
        Height="520" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackground}" Foreground="{DynamicResource TextForeground}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="16" HorizontalAlignment="Right">
            <Button Content="{Binding [dialog.ok], Source={x:Static i18n:Loc.Source}}" Width="88" IsDefault="True" Click="Ok_Click"/>
            <Button Content="{Binding [dialog.cancel], Source={x:Static i18n:Loc.Source}}" Width="88" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding [prefs.language], Source={x:Static i18n:Loc.Source}}"/>
                <ComboBox x:Name="LanguageBox" Margin="0,4,0,12" Width="220" HorizontalAlignment="Left"
                          SelectionChanged="PrefsChanged">
                    <ComboBoxItem Content="{Binding [prefs.english], Source={x:Static i18n:Loc.Source}}" Tag="En"/>
                    <ComboBoxItem Content="{Binding [prefs.japanese], Source={x:Static i18n:Loc.Source}}" Tag="Ja"/>
                </ComboBox>
                <TextBlock Text="{Binding [prefs.theme], Source={x:Static i18n:Loc.Source}}"/>
                <ComboBox x:Name="ThemeBox" Margin="0,4,0,16" Width="220" HorizontalAlignment="Left"
                          SelectionChanged="PrefsChanged">
                    <ComboBoxItem Content="{Binding [prefs.themeDark], Source={x:Static i18n:Loc.Source}}" Tag="Dark"/>
                    <ComboBoxItem Content="{Binding [prefs.themeLight], Source={x:Static i18n:Loc.Source}}" Tag="Light"/>
                    <ComboBoxItem Content="{Binding [prefs.themeSystem], Source={x:Static i18n:Loc.Source}}" Tag="System"/>
                </ComboBox>
                <TextBlock Text="{Binding [prefs.help], Source={x:Static i18n:Loc.Source}}" FontWeight="Bold"/>
                <TextBlock Margin="0,8,0,16">
                    <Hyperlink x:Name="DocsLink"
                               RequestNavigate="AboutLink_RequestNavigate"
                               Foreground="{DynamicResource TextForeground}">
                        <Run x:Name="DocsLinkText"/>
                    </Hyperlink>
                </TextBlock>
                <TextBlock Text="{Binding [about.name], Source={x:Static i18n:Loc.Source}}" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="AboutVersion" Margin="0,8,0,0"/>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="{Binding [about.blurb], Source={x:Static i18n:Loc.Source}}"/>
                <TextBlock Margin="0,8,0,0"
                           Text="{Binding [about.author], Source={x:Static i18n:Loc.Source}}"/>
                <TextBlock Margin="0,8,0,0">
                    <Hyperlink NavigateUri="https://github.com/MikanseiLaboratory/eiviz"
                               RequestNavigate="AboutLink_RequestNavigate"
                               Foreground="{DynamicResource TextForeground}">
                        https://github.com/MikanseiLaboratory/eiviz
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,4,0,0">
                    <Hyperlink NavigateUri="https://mikanseilaboratory.github.io/"
                               RequestNavigate="AboutLink_RequestNavigate"
                               Foreground="{DynamicResource TextForeground}">
                        https://mikanseilaboratory.github.io/
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,12,0,0" FontWeight="Bold"
                           Text="{Binding [about.openSource], Source={x:Static i18n:Loc.Source}}"/>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DimForeground}"
                           Text="{Binding [about.license], Source={x:Static i18n:Loc.Source}}"/>
                <Button Content="THIRD_PARTY_NOTICES.md" Width="220" Height="28" Margin="0,12,0,0"
                        HorizontalAlignment="Left" Click="OpenNotices_Click"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
