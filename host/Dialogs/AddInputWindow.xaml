<Window x:Class="Eiviz.Host.Dialogs.AddInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input Select" Height="640" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#2B2B2B" Foreground="#EEEEEE">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#1E1E1E">
            <StackPanel x:Name="CategoryPanel" Margin="0,8,0,8"/>
        </Border>
        <DockPanel Grid.Column="1" Margin="16">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="OkButton" Content="OK" Width="88" Height="28" IsDefault="True" Click="Ok_Click"/>
                <Button Content="Cancel" Width="88" Height="28" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Name"/>
                <TextBox x:Name="NameBox" Margin="0,4,0,0"/>
                <TextBlock x:Name="IdLabel" Visibility="Collapsed" Margin="0,8,0,0" Foreground="#AAAAAA"/>
                <TextBlock Text="Tags" Margin="0,8,0,4"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="+" Width="28" Height="22" Click="AddTag_Click"/>
                    <WrapPanel x:Name="TagPanel" Margin="0,0,8,0"/>
                </DockPanel>
            </StackPanel>
            <Grid>
                <StackPanel x:Name="ColourPanel" Visibility="Collapsed">
                    <TextBlock Text="Colour generator" Margin="0,0,0,8"/>
                    <RadioButton x:Name="SolidRadio" Content="Solid colour" GroupName="ColourMode" IsChecked="True" Foreground="#EEE"/>
                    <RadioButton x:Name="BarsRadio" Content="SMPTE HD colour bars" GroupName="ColourMode" Margin="0,6,0,12" Foreground="#EEE"/>
                    <TextBlock Text="RGB"/>
                    <DockPanel Margin="0,4,0,4">
                        <TextBlock Text="R" Width="16" VerticalAlignment="Center"/>
                        <Slider x:Name="RSlider" Maximum="255" Value="220" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Colour_Changed"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="G" Width="16" VerticalAlignment="Center"/>
                        <Slider x:Name="GSlider" Maximum="255" Value="32" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Colour_Changed"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="B" Width="16" VerticalAlignment="Center"/>
                        <Slider x:Name="BSlider" Maximum="255" Value="32" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Colour_Changed"/>
                    </DockPanel>
                    <Border x:Name="ColourPreview" Height="48" Margin="0,0,0,12" Background="#DC2020"/>
                    <CheckBox x:Name="ScrollBox" Content="Scroll" Foreground="#EEE"/>
                    <TextBlock Text="Test tone" Margin="0,12,0,4"/>
                    <ComboBox x:Name="ToneBox" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <ComboBoxItem Content="Mute" Tag="0"/>
                        <ComboBoxItem Content="440 Hz" Tag="440"/>
                        <ComboBoxItem Content="1 kHz" Tag="1000" IsSelected="True"/>
                        <ComboBoxItem Content="2 kHz" Tag="2000"/>
                    </ComboBox>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#AAAAAA"
                               Text="Scroll shifts SMPTE HD bars (or a white ident on solid colours). Tone is -20 dBFS."/>
                </StackPanel>
                <StackPanel x:Name="StillPanel" Visibility="Visible">
                    <TextBlock Text="Select the still image to open." Margin="0,0,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse" Width="88" Click="BrowseStill_Click"/>
                        <TextBox x:Name="StillPath" Margin="0,0,8,0"/>
                    </DockPanel>
                    <TextBlock Text="Recent" Margin="0,12,0,4"/>
                    <ListBox x:Name="StillRecent" Height="240" Background="#333" Foreground="#EEE"
                             MouseDoubleClick="StillRecent_DoubleClick"/>
                </StackPanel>
                <StackPanel x:Name="VideoPanel" Visibility="Collapsed">
                    <TextBlock Text="Select the video file to open." Margin="0,0,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse" Width="88" Click="BrowseVideo_Click"/>
                        <TextBox x:Name="VideoPath" Margin="0,0,8,0"/>
                    </DockPanel>
                    <CheckBox x:Name="VideoLoopBox" Content="Loop" IsChecked="True"
                              Foreground="#EEE" Margin="0,12,0,8"/>
                    <TextBlock Text="Frame buffer (frames)" Margin="0,0,0,4"/>
                    <ComboBox x:Name="VideoBufferBox" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <ComboBoxItem Content="1" Tag="1"/>
                        <ComboBoxItem Content="2" Tag="2"/>
                        <ComboBoxItem Content="3" Tag="3" IsSelected="True"/>
                        <ComboBoxItem Content="4" Tag="4"/>
                        <ComboBoxItem Content="6" Tag="6"/>
                        <ComboBoxItem Content="8" Tag="8"/>
                    </ComboBox>
                    <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" Margin="0,0,0,8"
                               Text="Frame buffer (1–8) absorbs decode jitter."/>
                    <TextBlock Text="Play when" Margin="0,0,0,4"/>
                    <ComboBox x:Name="VideoPlayBox" Width="280" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <ComboBoxItem Content="Never (manual)" Tag="0" IsSelected="True"/>
                        <ComboBoxItem Content="Active (Program)" Tag="1"/>
                        <ComboBoxItem Content="On Preview" Tag="2"/>
                        <ComboBoxItem Content="Always" Tag="3"/>
                    </ComboBox>
                    <TextBlock Text="Restart when" Margin="0,0,0,4"/>
                    <ComboBox x:Name="VideoRestartBox" Width="280" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <ComboBoxItem Content="Never" Tag="0" IsSelected="True"/>
                        <ComboBoxItem Content="Active (Program)" Tag="1"/>
                        <ComboBoxItem Content="Taken off Active" Tag="2"/>
                        <ComboBoxItem Content="On Preview" Tag="3"/>
                    </ComboBox>
                    <TextBlock Text="Pause when" Margin="0,0,0,4"/>
                    <ComboBox x:Name="VideoPauseBox" Width="280" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <ComboBoxItem Content="Never" Tag="0" IsSelected="True"/>
                        <ComboBoxItem Content="Active (Program)" Tag="1"/>
                        <ComboBoxItem Content="Taken off Active" Tag="2"/>
                        <ComboBoxItem Content="On Preview" Tag="3"/>
                    </ComboBox>
                    <TextBlock Text="Recent" Margin="0,8,0,4"/>
                    <ListBox x:Name="VideoRecent" Height="140" Background="#333" Foreground="#EEE"
                             MouseDoubleClick="VideoRecent_DoubleClick"/>
                </StackPanel>
                <StackPanel x:Name="OmtPanel" Visibility="Collapsed">
                    <TextBlock Text="OMT source address" Margin="0,0,0,8"/>
                    <TextBox x:Name="OmtAddress"/>
                    <Button Content="Refresh discovery" Margin="0,12,0,8" HorizontalAlignment="Left" Click="RefreshOmt_Click"/>
                    <ListBox x:Name="OmtList" Height="132" Background="#333" Foreground="#EEE"
                             SelectionChanged="OmtList_SelectionChanged"/>
                    <TextBlock Text="Decode path" Margin="0,12,0,4"/>
                    <ComboBox x:Name="OmtPathBox" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <ComboBoxItem Content="GPU decode" Tag="gpu" IsSelected="True"/>
                        <ComboBoxItem Content="CPU decode" Tag="cpu"/>
                    </ComboBox>
                    <TextBlock Text="Quality" Margin="0,0,0,4"/>
                    <ComboBox x:Name="OmtQualityBox" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <ComboBoxItem Content="Default" Tag="0" IsSelected="True"/>
                        <ComboBoxItem Content="Low" Tag="1"/>
                        <ComboBoxItem Content="Medium" Tag="50"/>
                        <ComboBoxItem Content="High" Tag="100"/>
                    </ComboBox>
                    <TextBlock Text="Frame buffer (frames)"/>
                    <ComboBox x:Name="OmtBufferBox" Width="220" HorizontalAlignment="Left" Margin="0,4,0,8">
                        <ComboBoxItem Content="1" Tag="1" IsSelected="True"/>
                        <ComboBoxItem Content="2" Tag="2"/>
                        <ComboBoxItem Content="3" Tag="3"/>
                        <ComboBoxItem Content="4" Tag="4"/>
                        <ComboBoxItem Content="6" Tag="6"/>
                        <ComboBoxItem Content="8" Tag="8"/>
                    </ComboBox>
                    <TextBlock Text="Save bandwidth when" Margin="0,4,0,4"/>
                    <ComboBox x:Name="OmtSaveBox" Width="280" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <ComboBoxItem Content="Always (low quality)" Tag="0"/>
                        <ComboBoxItem Content="Not on Program (any MU)" Tag="1"/>
                        <ComboBoxItem Content="Not on Preview/Program (any MU)" Tag="2" IsSelected="True"/>
                        <ComboBoxItem Content="None (always full)" Tag="3"/>
                    </ComboBox>
                    <CheckBox x:Name="OmtMvBox" Content="Keep full quality on Multiview" Foreground="#EEE" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA"
                               Text="GPU decode keeps VMX frames on the GPU. CPU decode copies into system memory. Frame buffer (1–8) absorbs jitter on this source. Quality is requested from the sender. Unused sources stay connected and also request Preview (1/8 decode)."/>
                </StackPanel>
                <StackPanel x:Name="NdiPanel" Visibility="Collapsed">
                    <TextBlock Text="NDI® source" Margin="0,0,0,8"/>
                    <TextBox x:Name="NdiAddress"/>
                    <Button Content="Refresh discovery" Margin="0,12,0,8" HorizontalAlignment="Left" Click="RefreshNdi_Click"/>
                    <ListBox x:Name="NdiList" Height="132" Background="#333" Foreground="#EEE"
                             SelectionChanged="NdiList_SelectionChanged"/>
                    <TextBlock Text="Frame buffer (frames)" Margin="0,12,0,0"/>
                    <ComboBox x:Name="NdiBufferBox" Width="220" HorizontalAlignment="Left" Margin="0,4,0,8">
                        <ComboBoxItem Content="1" Tag="1" IsSelected="True"/>
                        <ComboBoxItem Content="2" Tag="2"/>
                        <ComboBoxItem Content="3" Tag="3"/>
                        <ComboBoxItem Content="4" Tag="4"/>
                        <ComboBoxItem Content="6" Tag="6"/>
                        <ComboBoxItem Content="8" Tag="8"/>
                    </ComboBox>
                    <TextBlock Text="Bandwidth" Margin="0,4,0,4"/>
                    <ComboBox x:Name="NdiBandwidthBox" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <ComboBoxItem Content="Highest" Tag="0" IsSelected="True"/>
                        <ComboBoxItem Content="Lowest" Tag="1"/>
                    </ComboBox>
                    <TextBlock x:Name="NdiStatus" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#C88"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA"
                               Text="NDI is received on the CPU and uploaded for compose. Frame buffer (1–8) absorbs jitter on this source. Bandwidth is set when connecting. Lowest is the public SDK preview stream."/>
                </StackPanel>
                <StackPanel x:Name="UvcPanel" Visibility="Collapsed">
                    <TextBlock Text="Select a UVC / Media Foundation capture device." Margin="0,0,0,8"/>
                    <Button Content="Refresh devices" HorizontalAlignment="Left" Click="RefreshUvc_Click"/>
                    <ListBox x:Name="UvcList" Height="220" Margin="0,12,0,8" Background="#333" Foreground="#EEE"
                             SelectionChanged="UvcList_SelectionChanged"/>
                    <TextBlock Text="Mode" Margin="0,0,0,4"/>
                    <ComboBox x:Name="UvcModeBox" Height="28"/>
                    <TextBlock Text="Frame buffer (frames)" Margin="0,12,0,4"/>
                    <ComboBox x:Name="UvcBufferBox" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <ComboBoxItem Content="1" Tag="1"/>
                        <ComboBoxItem Content="2" Tag="2"/>
                        <ComboBoxItem Content="3" Tag="3" IsSelected="True"/>
                        <ComboBoxItem Content="4" Tag="4"/>
                        <ComboBoxItem Content="6" Tag="6"/>
                        <ComboBoxItem Content="8" Tag="8"/>
                    </ComboBox>
                    <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA"
                               Text="Frame buffer (1–8) holds decoded camera frames on the GPU, same as NDI/OMT."/>
                </StackPanel>
                <StackPanel x:Name="MixPanel" Visibility="Collapsed">
                    <TextBlock Text="Mixing Unit or session Multiview" Margin="0,0,0,8"/>
                    <ComboBox x:Name="MixTargetBox" Height="28" SelectionChanged="MixTarget_Changed"/>
                    <TextBlock Text="Bus" Margin="0,12,0,4"/>
                    <ComboBox x:Name="MixBusBox" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <ComboBoxItem Content="Preview" Tag="preview"/>
                        <ComboBoxItem Content="Program" Tag="program" IsSelected="True"/>
                    </ComboBox>
                    <TextBlock Text="Frame buffer (frames)" Margin="0,0,0,4"/>
                    <ComboBox x:Name="MixBufferBox" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <ComboBoxItem Content="1" Tag="1" IsSelected="True"/>
                        <ComboBoxItem Content="2" Tag="2"/>
                        <ComboBoxItem Content="3" Tag="3"/>
                        <ComboBoxItem Content="4" Tag="4"/>
                        <ComboBoxItem Content="6" Tag="6"/>
                        <ComboBoxItem Content="8" Tag="8"/>
                    </ComboBox>
                    <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA"
                               Text="Mix Input reads N frames ago from the existing delay ring. Same Mixing Unit wiring is refused. Session Multiview Mix Inputs are muted by default."/>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
