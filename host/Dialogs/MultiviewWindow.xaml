<Window x:Class="Eiviz.Host.Dialogs.MultiviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:Eiviz.Host.Preview"
        Title="Multiview" Height="792" Width="1280"
        Background="#111" Foreground="#EEEEEE"
        PreviewKeyDown="Window_KeyDown"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="Chrome" Background="#252525" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Preview refresh" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="PresentBox" Width="168" Margin="0,0,8,0" VerticalAlignment="Center"
                              SelectionChanged="PresentBox_SelectionChanged">
                        <ComboBoxItem Content="Follow project" Tag="0"/>
                        <ComboBoxItem Content="Every frame" Tag="1"/>
                        <ComboBoxItem Content="Every 2 frames" Tag="2"/>
                        <ComboBoxItem Content="Every 3 frames" Tag="3"/>
                        <ComboBoxItem Content="Every 4 frames" Tag="4"/>
                        <ComboBoxItem Content="Every 6 frames" Tag="6"/>
                        <ComboBoxItem Content="Every 8 frames" Tag="8"/>
                    </ComboBox>
                    <Button Content="Tiles…" Width="72" Click="Tiles_Click"/>
                    <Button Content="Fullscreen" Width="88" Margin="8,0,0,0" Click="Fullscreen_Click"/>
                </StackPanel>
                <TextBlock x:Name="TitleText" Text="Multiview" VerticalAlignment="Center" FontWeight="Bold"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Background="#111">
            <preview:AspectBox RatioWidth="16" RatioHeight="9"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                <preview:SwapchainHost x:Name="MultiviewHost" IsMonitor="True"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </preview:AspectBox>
        </Grid>
    </Grid>
</Window>
