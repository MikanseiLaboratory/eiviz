<Window x:Class="Eiviz.Host.Dialogs.MultiviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:Eiviz.Host.Preview"
        xmlns:i18n="clr-namespace:Eiviz.Host.I18n"
        Title="{Binding [chrome.multiview], Source={x:Static i18n:Loc.Source}}" Height="792" Width="1280"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextForeground}"
        PreviewKeyDown="Window_KeyDown"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="Chrome" Background="{DynamicResource ChromeBackground}" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="OnTopBox" Content="{Binding [mv.alwaysOnTop], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center" Margin="0,0,12,0"
                              Foreground="{DynamicResource TextForeground}" Click="OnTop_Click"/>
                    <TextBlock Text="{Binding [mv.labelPosition], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="AnchorBox" Width="88" Margin="0,0,8,0" VerticalAlignment="Center"
                              SelectionChanged="AnchorBox_SelectionChanged">
                        <ComboBoxItem Content="{Binding [mv.bottom], Source={x:Static i18n:Loc.Source}}" Tag="Bottom"/>
                        <ComboBoxItem Content="{Binding [mv.top], Source={x:Static i18n:Loc.Source}}" Tag="Top"/>
                    </ComboBox>
                    <TextBlock Text="{Binding [settings.mvLabelSize], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="SizeBox" Width="48" Height="24" Margin="0,0,4,0" VerticalAlignment="Center"
                             LostFocus="SizeBox_LostFocus"/>
                    <ComboBox x:Name="UnitBox" Width="56" Margin="0,0,8,0" VerticalAlignment="Center"
                              SelectionChanged="UnitBox_SelectionChanged">
                        <ComboBoxItem Content="px" Tag="Px"/>
                        <ComboBoxItem Content="%" Tag="Percent"/>
                    </ComboBox>
                    <TextBlock Text="{Binding [mv.previewRefresh], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="PresentBox" Width="168" Margin="0,0,8,0" VerticalAlignment="Center"
                              SelectionChanged="PresentBox_SelectionChanged">
                        <ComboBoxItem Content="{Binding [settings.followProject], Source={x:Static i18n:Loc.Source}}" Tag="0"/>
                        <ComboBoxItem Content="{Binding [settings.everyFrame], Source={x:Static i18n:Loc.Source}}" Tag="1"/>
                        <ComboBoxItem Content="Every 2 frames" Tag="2"/>
                        <ComboBoxItem Content="Every 3 frames" Tag="3"/>
                        <ComboBoxItem Content="Every 4 frames" Tag="4"/>
                        <ComboBoxItem Content="Every 6 frames" Tag="6"/>
                        <ComboBoxItem Content="Every 8 frames" Tag="8"/>
                    </ComboBox>
                    <Button Content="{Binding [mv.tiles], Source={x:Static i18n:Loc.Source}}" Width="72" Click="Tiles_Click"/>
                    <Button Content="{Binding [mv.fullscreen], Source={x:Static i18n:Loc.Source}}" Width="88" Margin="8,0,0,0" Click="Fullscreen_Click"/>
                </StackPanel>
                <TextBlock x:Name="TitleText" Text="Multiview" VerticalAlignment="Center" FontWeight="Bold"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Background="{DynamicResource WindowBackground}">
            <preview:AspectBox RatioWidth="16" RatioHeight="9"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                <preview:SwapchainHost x:Name="MultiviewHost" IsMonitor="True"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </preview:AspectBox>
        </Grid>
    </Grid>
</Window>
