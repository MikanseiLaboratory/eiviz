<Window x:Class="Eiviz.Host.Dialogs.SwitcherScenesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scenes" Height="420" Width="360"
        WindowStartupLocation="CenterOwner"
        Background="#2B2B2B" Foreground="#EEEEEE"
        ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#222222"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#222222"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2B2B2B"/>
        <Style TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#555555"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#222222"/>
                    <Setter Property="Foreground" Value="#EEEEEE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="88" Height="28" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="88" Height="28" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <RadioButton x:Name="AllBox" GroupName="Mode" Margin="0,0,0,6" Checked="Mode_Changed"/>
            <RadioButton x:Name="IncludeBox" GroupName="Mode" Margin="0,0,0,6" Checked="Mode_Changed"/>
            <RadioButton x:Name="ExcludeBox" GroupName="Mode" Margin="0,0,0,8" Checked="Mode_Changed"/>
            <ListBox x:Name="SceneList" Height="240"/>
        </StackPanel>
    </DockPanel>
</Window>
