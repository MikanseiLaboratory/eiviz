<Window x:Class="Eiviz.Host.Dialogs.SceneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:Eiviz.Host.Preview"
        Title="Scene Editor" Height="800" Width="1360"
        WindowStartupLocation="CenterOwner"
        Background="#2B2B2B" Foreground="#EEEEEE">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Layers" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Text="Preset (all layers)" Margin="0,8,0,4"/>
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                    <WrapPanel x:Name="PresetCards"/>
                </ScrollViewer>
                <TextBlock Text="Copy from" Margin="0,8,0,4"/>
                <ComboBox x:Name="CopyFromBox" Height="28" SelectionChanged="CopyFrom_SelectionChanged"/>
                <Button Content="Save preset" Height="26" Margin="0,8,0,8" Click="SavePreset_Click"/>
                <ComboBox x:Name="InputPick" Margin="0,0,0,6"/>
                <Button Content="Add layer" Height="28" Click="AddLayer_Click"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Z up" Width="72" Click="ZUp_Click"/>
                    <Button Content="Z down" Width="72" Margin="6,0,0,0" Click="ZDown_Click"/>
                    <Button Content="Delete" Width="72" Margin="6,0,0,0" Click="DeleteLayer_Click"/>
                </StackPanel>
            </StackPanel>
            <ListBox x:Name="LayerList" Background="#222" Foreground="#EEE" BorderBrush="#444"
                     SelectionChanged="LayerList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="4,2"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
        <DockPanel Grid.Column="1" Margin="12,0">
            <TextBlock x:Name="WireLabel" DockPanel.Dock="Top" Text="Wireframe" FontWeight="Bold" Margin="0,0,0,6"/>
            <Border Background="#111" BorderBrush="#555" BorderThickness="1" ClipToBounds="True">
                <Viewbox Stretch="Uniform" ClipToBounds="True">
                    <Canvas x:Name="WireCanvas" Width="1920" Height="1080" Background="#0A0A0A"
                            ClipToBounds="True"
                            MouseLeftButtonDown="WireCanvas_MouseLeftButtonDown"
                            MouseMove="WireCanvas_MouseMove"
                            MouseLeftButtonUp="WireCanvas_MouseLeftButtonUp"/>
                </Viewbox>
            </Border>
        </DockPanel>
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Live preview" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Text="Name" Margin="0,8,0,4"/>
                <TextBox x:Name="NameBox"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PosXLabel" Text="Pos X" VerticalAlignment="Center"/>
                    <TextBox x:Name="XBox" Grid.Column="1" Margin="0,0,8,6" LostFocus="Numeric_LostFocus"/>
                    <TextBlock x:Name="PosYLabel" Grid.Column="3" Text="Pos Y" VerticalAlignment="Center"/>
                    <TextBox x:Name="YBox" Grid.Column="4" Margin="0,0,0,6" LostFocus="Numeric_LostFocus"/>
                    <TextBlock x:Name="SizeXLabel" Grid.Row="1" Text="Size X" VerticalAlignment="Center"/>
                    <TextBox x:Name="WBox" Grid.Row="1" Grid.Column="1" Margin="0,0,4,6" LostFocus="Numeric_LostFocus"/>
                    <CheckBox x:Name="LinkBox" Grid.Row="1" Grid.Column="2"
                              Content="Link" VerticalAlignment="Center" Margin="0,0,4,6" Foreground="#EEEEEE"
                              Click="Link_Click"/>
                    <TextBlock x:Name="SizeYLabel" Grid.Row="1" Grid.Column="3" Text="Size Y" VerticalAlignment="Center"/>
                    <TextBox x:Name="HBox" Grid.Row="1" Grid.Column="4" Margin="0,0,0,6" LostFocus="Numeric_LostFocus"/>
                    <TextBlock x:Name="CropXLabel" Grid.Row="2" Text="Crop X" VerticalAlignment="Center"/>
                    <TextBox x:Name="CropXBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,6" LostFocus="Numeric_LostFocus"/>
                    <TextBlock x:Name="CropYLabel" Grid.Row="2" Grid.Column="3" Text="Crop Y" VerticalAlignment="Center"/>
                    <TextBox x:Name="CropYBox" Grid.Row="2" Grid.Column="4" Margin="0,0,0,6" LostFocus="Numeric_LostFocus"/>
                    <TextBlock x:Name="CropWLabel" Grid.Row="3" Text="Crop W" VerticalAlignment="Center"/>
                    <TextBox x:Name="CropWBox" Grid.Row="3" Grid.Column="1" Margin="0,0,8,6" LostFocus="Numeric_LostFocus"/>
                    <TextBlock x:Name="CropHLabel" Grid.Row="3" Grid.Column="3" Text="Crop H" VerticalAlignment="Center"/>
                    <TextBox x:Name="CropHBox" Grid.Row="3" Grid.Column="4" Margin="0,0,0,6" LostFocus="Numeric_LostFocus"/>
                    <TextBlock x:Name="OpLabel" Grid.Row="4" Text="Opacity" VerticalAlignment="Center"/>
                    <TextBox x:Name="OpBox" Grid.Row="4" Grid.Column="1" Margin="0,0,8,6" LostFocus="Numeric_LostFocus"/>
                    <TextBlock Grid.Row="5" Text="Input" VerticalAlignment="Center"/>
                    <ComboBox x:Name="LayerInputBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4"
                              Margin="0,0,0,6" DisplayMemberPath="Name"
                              SelectionChanged="LayerInput_SelectionChanged"/>
                    <CheckBox x:Name="AudioFollowBox" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5"
                              Content="Audio Follow" VerticalAlignment="Center" Foreground="#EEEEEE"
                              Click="AudioFollow_Click"/>
                    <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="5" Content="Reset"
                            Height="26" Margin="0,8,0,0" Click="ResetLayer_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="OK" Width="88" IsDefault="True" Click="Ok_Click"/>
                    <Button Content="Cancel" Width="88" Margin="8,0,0,0" IsCancel="True"/>
                </StackPanel>
            </StackPanel>
            <Border Background="#111" BorderBrush="#555" BorderThickness="1" Margin="0,0,0,12">
                <preview:AspectBox x:Name="PreviewAspect" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <preview:SwapchainHost x:Name="PreviewHost" IsMonitor="True"/>
                </preview:AspectBox>
            </Border>
        </DockPanel>
    </Grid>
</Window>
