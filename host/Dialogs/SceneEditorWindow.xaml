<Window x:Class="Eiviz.Host.Dialogs.SceneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:Eiviz.Host.Preview"
        Title="Scene Editor" Height="720" Width="1280"
        WindowStartupLocation="CenterOwner"
        Background="#2B2B2B" Foreground="#EEEEEE">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Layers" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Bottom">
                <ComboBox x:Name="InputPick" Margin="0,0,0,6"/>
                <Button Content="Add layer" Height="28" Click="AddLayer_Click"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Z up" Width="72" Click="ZUp_Click"/>
                    <Button Content="Z down" Width="72" Margin="6,0,0,0" Click="ZDown_Click"/>
                    <Button Content="Delete" Width="72" Margin="6,0,0,0" Click="DeleteLayer_Click"/>
                </StackPanel>
            </StackPanel>
            <ListBox x:Name="LayerList" Background="#222" Foreground="#EEE" BorderBrush="#444"
                     SelectionChanged="LayerList_SelectionChanged"/>
        </DockPanel>
        <DockPanel Grid.Column="1" Margin="12,0">
            <TextBlock DockPanel.Dock="Top" Text="Wireframe (16:9)" FontWeight="Bold" Margin="0,0,0,6"/>
            <Border Background="#111" BorderBrush="#555" BorderThickness="1">
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="WireCanvas" Width="1600" Height="900" Background="#0A0A0A"
                            MouseLeftButtonDown="WireCanvas_MouseLeftButtonDown"
                            MouseMove="WireCanvas_MouseMove"
                            MouseLeftButtonUp="WireCanvas_MouseLeftButtonUp"/>
                </Viewbox>
            </Border>
        </DockPanel>
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Live preview" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Text="Name" Margin="0,8,0,4"/>
                <TextBox x:Name="NameBox"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="X" VerticalAlignment="Center"/>
                    <TextBox x:Name="XBox" Grid.Column="1" Margin="0,0,8,6" LostFocus="Numeric_LostFocus"/>
                    <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center"/>
                    <TextBox x:Name="YBox" Grid.Column="3" Margin="0,0,0,6" LostFocus="Numeric_LostFocus"/>
                    <TextBlock Grid.Row="1" Text="W" VerticalAlignment="Center"/>
                    <TextBox x:Name="WBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,6" LostFocus="Numeric_LostFocus"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="H" VerticalAlignment="Center"/>
                    <TextBox x:Name="HBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,6" LostFocus="Numeric_LostFocus"/>
                    <TextBlock Grid.Row="2" Text="Op" VerticalAlignment="Center"/>
                    <TextBox x:Name="OpBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,6" LostFocus="Numeric_LostFocus"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="OK" Width="88" IsDefault="True" Click="Ok_Click"/>
                    <Button Content="Cancel" Width="88" Margin="8,0,0,0" IsCancel="True"/>
                </StackPanel>
            </StackPanel>
            <Border Background="#111" BorderBrush="#555" BorderThickness="1" MinHeight="180" Margin="0,0,0,12">
                <preview:SwapchainHost x:Name="PreviewHost" IsMonitor="True" MinHeight="180"/>
            </Border>
        </DockPanel>
    </Grid>
</Window>
