<Window x:Class="Eiviz.Host.Dialogs.ReplaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:Eiviz.Host.I18n"
        Title="{Binding [replay.setupTitle], Source={x:Static i18n:Loc.Source}}"
        Width="720" Height="700" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ApplyButton" Width="110" Height="32" IsDefault="True" Click="Apply_Click"
                    Content="{Binding [replay.apply], Source={x:Static i18n:Loc.Source}}"/>
            <Button Width="110" Height="32" Margin="8,0,0,0" IsCancel="True"
                    Content="{Binding [dialog.cancel], Source={x:Static i18n:Loc.Source}}"/>
        </StackPanel>

        <TextBlock x:Name="PlanText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontWeight="Bold" Text="{Binding [replay.storage], Source={x:Static i18n:Loc.Source}}"/>
                <TextBlock Text="{Binding [settings.replayPath], Source={x:Static i18n:Loc.Source}}" Margin="0,8,0,4"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Width="110" Height="24" Margin="8,0,0,0" Click="AddStorage_Click"
                            Content="{Binding [replay.addStorage], Source={x:Static i18n:Loc.Source}}"/>
                    <TextBox x:Name="PathBox"/>
                </DockPanel>
                <ListView x:Name="StorageList" Height="96" Margin="0,8,0,0" SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{Binding [settings.replayPath], Source={x:Static i18n:Loc.Source}}" Width="380"
                                            DisplayMemberBinding="{Binding Path}"/>
                            <GridViewColumn Header="{Binding [replay.angle], Source={x:Static i18n:Loc.Source}}" Width="160"
                                            DisplayMemberBinding="{Binding Angles}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Width="110" Height="24" Click="RemoveStorage_Click"
                            Content="{Binding [replay.removeStorage], Source={x:Static i18n:Loc.Source}}"/>
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"
                               Text="{Binding [replay.storageHelp], Source={x:Static i18n:Loc.Source}}"/>
                </StackPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{Binding [settings.replayProfile], Source={x:Static i18n:Loc.Source}}"/>
                        <ComboBox x:Name="ProfileBox" Margin="0,4,0,0">
                            <ComboBoxItem Content="HQ" Tag="Hq"/>
                            <ComboBoxItem Content="SQ" Tag="Sq" IsSelected="True"/>
                            <ComboBoxItem Content="LQ" Tag="Lq"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{Binding [replay.retention], Source={x:Static i18n:Loc.Source}}"/>
                        <ComboBox x:Name="RetentionBox" Margin="0,4,0,0" SelectionChanged="Retention_SelectionChanged"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{Binding [settings.replayQueue], Source={x:Static i18n:Loc.Source}}"/>
                        <TextBox x:Name="QueueBox" Margin="0,4,0,0" Text="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                        <TextBlock Text="{Binding [settings.replayBuffer], Source={x:Static i18n:Loc.Source}}"/>
                        <TextBox x:Name="BufferBox" Margin="0,4,0,0" Text="512"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock Text="{Binding [replay.reserve], Source={x:Static i18n:Loc.Source}}"/>
                        <TextBox x:Name="ReserveBox" Margin="0,4,0,0" Text="2048"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{Binding [replay.overflow], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="OverflowBox" Width="200" Margin="8,0,0,0">
                        <ComboBoxItem Content="{Binding [replay.overflowDrop], Source={x:Static i18n:Loc.Source}}" Tag="DropFrames" IsSelected="True"/>
                        <ComboBoxItem Content="{Binding [replay.overflowStop], Source={x:Static i18n:Loc.Source}}" Tag="StopRecording"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock FontWeight="Bold" Margin="0,20,0,0"
                           Text="{Binding [replay.angles], Source={x:Static i18n:Loc.Source}}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,6"
                           Text="{Binding [replay.anglesHelp], Source={x:Static i18n:Loc.Source}}"/>
                <ListView x:Name="AngleList" Height="180" SelectionMode="Single" SelectionChanged="AngleList_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{Binding [replay.name], Source={x:Static i18n:Loc.Source}}" Width="160"
                                            DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="{Binding [replay.scene], Source={x:Static i18n:Loc.Source}}" Width="200"
                                            DisplayMemberBinding="{Binding SceneName}"/>
                            <GridViewColumn Header="{Binding [replay.audio], Source={x:Static i18n:Loc.Source}}" Width="90"
                                            DisplayMemberBinding="{Binding Audio}"/>
                            <GridViewColumn Header="{Binding [replay.drive], Source={x:Static i18n:Loc.Source}}" Width="70"
                                            DisplayMemberBinding="{Binding Drive}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ComboBox x:Name="SceneBox" Width="220" DisplayMemberPath="Name"/>
                    <Button Width="110" Height="28" Margin="8,0,0,0" Click="AddAngle_Click"
                            Content="{Binding [replay.addAngle], Source={x:Static i18n:Loc.Source}}"/>
                    <Button Width="110" Height="28" Margin="8,0,0,0" Click="RemoveAngle_Click"
                            Content="{Binding [replay.removeAngle], Source={x:Static i18n:Loc.Source}}"/>
                    <ComboBox x:Name="AngleStorageBox" Width="150" Margin="16,0,0,0"/>
                    <Button Width="130" Height="28" Margin="8,0,0,0" Click="AssignStorage_Click"
                            Content="{Binding [replay.assignStorage], Source={x:Static i18n:Loc.Source}}"/>
                    <ComboBox x:Name="AngleAudioBox" Width="150" Margin="16,0,0,0"/>
                    <Button Width="130" Height="28" Margin="8,0,0,0" Click="AssignAudio_Click"
                            Content="{Binding [replay.assignAudio], Source={x:Static i18n:Loc.Source}}"/>
                </StackPanel>

                <CheckBox x:Name="AutoAddBox" Margin="0,20,0,0" Click="AutoAdd_Click"
                          Content="{Binding [replay.autoAdd], Source={x:Static i18n:Loc.Source}}"/>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="{Binding [replay.autoAddHelp], Source={x:Static i18n:Loc.Source}}"/>
                <TextBlock x:Name="ActiveAngleText" Margin="0,8,0,0"/>
                <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
