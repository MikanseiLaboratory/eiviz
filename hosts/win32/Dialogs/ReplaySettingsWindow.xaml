<Window x:Class="Eiviz.Host.Dialogs.ReplaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:Eiviz.Host.I18n"
        Title="{Binding [replay.setupTitle], Source={x:Static i18n:Loc.Source}}"
        Width="780" Height="780" MinWidth="660" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <Style x:Key="ReplayList" TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource ListBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
                        <Setter Property="Padding" Value="4,2"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="#B0B0B8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0B0B8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ApplyButton" Width="130" Height="34" IsDefault="True" Click="Apply_Click"
                    Content="{Binding [replay.apply], Source={x:Static i18n:Loc.Source}}"/>
            <Button Width="130" Height="34" Margin="8,0,0,0" Click="Cancel_Click"
                    Content="{Binding [dialog.cancel], Source={x:Static i18n:Loc.Source}}"/>
        </StackPanel>

        <TextBlock x:Name="PlanText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <!-- Apply and every refusal report here, at the top, where it cannot be
             missed without scrolling. -->
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                   FontWeight="Bold" Foreground="{DynamicResource HudForeground}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}"
                           Text="{Binding [replay.storage], Source={x:Static i18n:Loc.Source}}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Width="160" Height="30" Click="BrowseStorage_Click"
                            ToolTip="{Binding [replay.pickStorageHint], Source={x:Static i18n:Loc.Source}}"
                            Content="{Binding [replay.pickStorage], Source={x:Static i18n:Loc.Source}}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="10,0,0,0"
                               Text="{Binding [replay.storageHelp], Source={x:Static i18n:Loc.Source}}"/>
                </StackPanel>
                <ListView x:Name="StorageList" Style="{StaticResource ReplayList}" Height="120" Margin="0,8,0,0" SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{Binding [settings.replayPath], Source={x:Static i18n:Loc.Source}}" Width="440"
                                            DisplayMemberBinding="{Binding Path}"/>
                            <GridViewColumn Header="{Binding [replay.angle], Source={x:Static i18n:Loc.Source}}" Width="180"
                                            DisplayMemberBinding="{Binding Angles}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Width="130" Height="28" Click="RemoveStorage_Click"
                            Content="{Binding [replay.removeStorage], Source={x:Static i18n:Loc.Source}}"/>
                </StackPanel>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding [settings.replayProfile], Source={x:Static i18n:Loc.Source}}"/>
                        <ComboBox x:Name="ProfileBox" Height="28">
                            <ComboBoxItem Content="HQ" Tag="Hq"/>
                            <ComboBoxItem Content="SQ" Tag="Sq" IsSelected="True"/>
                            <ComboBoxItem Content="LQ" Tag="Lq"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding [replay.retention], Source={x:Static i18n:Loc.Source}}"/>
                        <ComboBox x:Name="RetentionBox" Height="28" SelectionChanged="Retention_SelectionChanged"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding [settings.replayQueue], Source={x:Static i18n:Loc.Source}}"/>
                        <TextBox x:Name="QueueBox" Height="28" Text="6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding [settings.replayBuffer], Source={x:Static i18n:Loc.Source}}"/>
                        <TextBox x:Name="BufferBox" Height="28" Text="512"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding [replay.reserve], Source={x:Static i18n:Loc.Source}}"/>
                        <TextBox x:Name="ReserveBox" Height="28" Text="2048"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="{Binding [replay.overflow], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="OverflowBox" Width="220" Height="28" Margin="8,0,0,0">
                        <ComboBoxItem Content="{Binding [replay.overflowDrop], Source={x:Static i18n:Loc.Source}}" Tag="DropFrames" IsSelected="True"/>
                        <ComboBoxItem Content="{Binding [replay.overflowStop], Source={x:Static i18n:Loc.Source}}" Tag="StopRecording"/>
                    </ComboBox>
                </StackPanel>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding [replay.formatFromUnit], Source={x:Static i18n:Loc.Source}}"/>
                        <TextBlock x:Name="FormatText" Height="28" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding [replay.segmentFrames], Source={x:Static i18n:Loc.Source}}"/>
                        <TextBox x:Name="SegmentFramesBox" Height="28" Text="120"
                                 ToolTip="{Binding [replay.segmentFramesRange], Source={x:Static i18n:Loc.Source}}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,20,0,6"
                           Text="{Binding [replay.angles], Source={x:Static i18n:Loc.Source}}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                           Text="{Binding [replay.anglesHelp], Source={x:Static i18n:Loc.Source}}"/>
                <ListView x:Name="AngleList" Style="{StaticResource ReplayList}" Height="170" SelectionMode="Single" SelectionChanged="AngleList_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{Binding [replay.name], Source={x:Static i18n:Loc.Source}}" Width="150"
                                            DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="{Binding [replay.sourceKind], Source={x:Static i18n:Loc.Source}}" Width="70"
                                            DisplayMemberBinding="{Binding SourceLabel}"/>
                            <GridViewColumn Header="{Binding [replay.source], Source={x:Static i18n:Loc.Source}}" Width="180"
                                            DisplayMemberBinding="{Binding SourceName}"/>
                            <GridViewColumn Header="{Binding [replay.recordMode], Source={x:Static i18n:Loc.Source}}" Width="110"
                                            DisplayMemberBinding="{Binding ModeLabel}"/>
                            <GridViewColumn Header="{Binding [replay.audio], Source={x:Static i18n:Loc.Source}}" Width="90"
                                            DisplayMemberBinding="{Binding Audio}"/>
                            <GridViewColumn Header="{Binding [replay.drive], Source={x:Static i18n:Loc.Source}}" Width="60"
                                            DisplayMemberBinding="{Binding Drive}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- The selected angle is edited in place: no "assign" step to forget. -->
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,10,0,4"
                           Text="{Binding [replay.selectedAngle], Source={x:Static i18n:Loc.Source}}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AngleNameBox" Grid.Column="0" Height="28" Margin="0,0,6,0"
                             LostFocus="AngleName_Changed" ToolTip="{Binding [replay.name], Source={x:Static i18n:Loc.Source}}"/>
                    <ComboBox x:Name="AngleModeBox" Grid.Column="1" Height="28" Margin="0,0,6,0"
                              SelectionChanged="AngleMode_Changed"
                              ToolTip="{Binding [replay.passthroughHelp], Source={x:Static i18n:Loc.Source}}"/>
                    <ComboBox x:Name="AngleAudioBox" Grid.Column="2" Height="28" Margin="0,0,6,0"
                              SelectionChanged="AngleAudio_Changed"
                              ToolTip="{Binding [replay.audioHelp], Source={x:Static i18n:Loc.Source}}"/>
                    <ComboBox x:Name="AngleStorageBox" Grid.Column="3" Height="28" Margin="0,0,6,0"
                              SelectionChanged="AngleStorage_Changed"
                              ToolTip="{Binding [replay.storageHelp], Source={x:Static i18n:Loc.Source}}"/>
                    <Button x:Name="RemoveAngleButton" Grid.Column="4" Width="110" Height="28" Click="RemoveAngle_Click"
                            Content="{Binding [replay.removeAngle], Source={x:Static i18n:Loc.Source}}"/>
                </Grid>

                <!-- Adding one: pick what to record, how, and where. -->
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,12,0,4"
                           Text="{Binding [replay.addAngle], Source={x:Static i18n:Loc.Source}}"/>
                <WrapPanel Orientation="Horizontal">
                    <ComboBox x:Name="SourceKindBox" Width="110" Height="28" Margin="0,0,6,6"
                              SelectionChanged="SourceKind_Changed"/>
                    <ComboBox x:Name="SourceBox" Width="220" Height="28" Margin="0,0,6,6"
                              SelectionChanged="Source_Changed"/>
                    <ComboBox x:Name="AddModeBox" Width="150" Height="28" Margin="0,0,6,6"
                              ToolTip="{Binding [replay.passthroughHelp], Source={x:Static i18n:Loc.Source}}"/>
                    <ComboBox x:Name="AddAudioBox" Width="140" Height="28" Margin="0,0,6,6"
                              ToolTip="{Binding [replay.audioHelp], Source={x:Static i18n:Loc.Source}}"/>
                    <ComboBox x:Name="AddDriveBox" Width="150" Height="28" Margin="0,0,6,6"
                              ToolTip="{Binding [replay.storageHelp], Source={x:Static i18n:Loc.Source}}"/>
                    <Button x:Name="AddAngleButton" Width="130" Height="28" Margin="0,0,0,6" Click="AddAngle_Click"
                            Content="{Binding [replay.addAngle], Source={x:Static i18n:Loc.Source}}"/>
                </WrapPanel>

                <CheckBox x:Name="AutoAddBox" Margin="0,20,0,0" Click="AutoAdd_Click"
                          Content="{Binding [replay.autoAdd], Source={x:Static i18n:Loc.Source}}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="{Binding [replay.autoAddHelp], Source={x:Static i18n:Loc.Source}}"/>
                <TextBlock x:Name="ActiveAngleText" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
