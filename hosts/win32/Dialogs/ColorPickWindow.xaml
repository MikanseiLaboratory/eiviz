<Window x:Class="Eiviz.Host.Dialogs.ColorPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color" Height="260" Width="360"
        WindowStartupLocation="CenterOwner"
        Background="#2B2B2B" Foreground="#EEEEEE"
        ResizeMode="NoResize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="88" Height="28" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="88" Height="28" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="PromptText" Text="RGB" Margin="0,0,0,8"/>
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="R" Width="16" VerticalAlignment="Center"/>
                <Slider x:Name="RSlider" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Colour_Changed"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="G" Width="16" VerticalAlignment="Center"/>
                <Slider x:Name="GSlider" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Colour_Changed"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="B" Width="16" VerticalAlignment="Center"/>
                <Slider x:Name="BSlider" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Colour_Changed"/>
            </DockPanel>
            <Border x:Name="Swatch" Height="48" BorderBrush="#666" BorderThickness="1"/>
        </StackPanel>
    </DockPanel>
</Window>
