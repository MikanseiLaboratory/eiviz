<Window x:Class="Eiviz.Host.Dialogs.SwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:Eiviz.Host.Preview"
        xmlns:i18n="clr-namespace:Eiviz.Host.I18n"
        Title="Switcher" Height="720" Width="1280"
        Background="#1A1A1A" Foreground="#EEEEEE">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#252525" Padding="8,6">
            <DockPanel>
                <CheckBox x:Name="OnTopBox" DockPanel.Dock="Right"
                          Content="{Binding [settings.alwaysOnTop], Source={x:Static i18n:Loc.Source}}"
                          VerticalAlignment="Center" Foreground="#EEEEEE" Click="OnTop_Click"/>
                <TextBlock x:Name="TitleText" Text="Switcher" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="140"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                    <ColumnDefinition Width="260" MinWidth="180"/>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                </Grid.ColumnDefinitions>
                <preview:AspectBox x:Name="PreviewAspect" HeaderHeight="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,0,8,0">
                    <Border x:Name="PreviewFrame" BorderBrush="#00FF00" BorderThickness="2" Background="#000">
                        <DockPanel>
                            <Border x:Name="PreviewHeader" DockPanel.Dock="Top" Background="#00FF00" Padding="8,4">
                                <TextBlock x:Name="PreviewHeaderText" Text="PREVIEW" FontWeight="Bold" Foreground="#111"/>
                            </Border>
                            <preview:SwapchainHost x:Name="PreviewHost" OutputKind="1" UnitId="1"/>
                        </DockPanel>
                    </Border>
                </preview:AspectBox>
                <GridSplitter Grid.Column="0" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="CurrentAndNext"
                              Background="#555"/>
                <Grid Grid.Column="1" Margin="16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Transitions" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TransitionPanel"/>
                    </ScrollViewer>
                    <Slider x:Name="TBar" Grid.Row="2" Orientation="Horizontal" Minimum="0" Maximum="1"
                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                            Margin="8,12,8,16" Height="18"
                            IsMoveToPointEnabled="True"
                            ValueChanged="TBar_ValueChanged"
                            PreviewMouseLeftButtonUp="TBar_MouseUp"
                            LostMouseCapture="TBar_LostMouseCapture"/>
                </Grid>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="CurrentAndNext"
                              Background="#555"/>
                <preview:AspectBox x:Name="ProgramAspect" Grid.Column="2" HeaderHeight="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="8,0,0,0">
                    <Border x:Name="ProgramFrame" BorderBrush="#FF0000" BorderThickness="2" Background="#000">
                        <DockPanel>
                            <Border x:Name="ProgramHeader" DockPanel.Dock="Top" Background="#FF0000" Padding="8,4">
                                <TextBlock x:Name="ProgramHeaderText" Text="PROGRAM" FontWeight="Bold"/>
                            </Border>
                            <preview:SwapchainHost x:Name="ProgramHost" OutputKind="0" UnitId="1"/>
                        </DockPanel>
                    </Border>
                </preview:AspectBox>
            </Grid>
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Background="#555"/>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="80"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120" MinHeight="60"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="{Binding [switcher.manageScenes], Source={x:Static i18n:Loc.Source}}"
                                Height="22" Padding="8,0" Click="ManageScenes_Click"/>
                        <TextBlock Text="{Binding [chrome.scenes], Source={x:Static i18n:Loc.Source}}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,4">
                        <StackPanel x:Name="SceneTabBar" Orientation="Horizontal"/>
                    </ScrollViewer>
                    <ScrollViewer x:Name="SceneScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="SceneStrip"/>
                    </ScrollViewer>
                </DockPanel>
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Background="#555"/>
                <Border Grid.Row="2" Background="#161616" Padding="8,6">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="{Binding [chrome.overlay], Source={x:Static i18n:Loc.Source}}"
                                    Width="88" Height="28" Click="OpenOverlay_Click"/>
                            <TextBlock Text="{Binding [chrome.overlay], Source={x:Static i18n:Loc.Source}}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="OverlayTogglePanel" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
