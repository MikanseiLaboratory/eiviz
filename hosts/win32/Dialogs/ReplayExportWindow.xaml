<Window x:Class="Eiviz.Host.Dialogs.ReplayExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:Eiviz.Host.I18n"
        Title="{Binding [replay.export], Source={x:Static i18n:Loc.Source}}"
        Width="720" Height="360" MinWidth="560" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#B0B0B8"
                   Text="{Binding [replay.exportHint], Source={x:Static i18n:Loc.Source}}"/>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                       Text="{Binding [replay.exportMode], Source={x:Static i18n:Loc.Source}}"/>
            <ComboBox x:Name="ExportModeBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                      AutomationProperties.AutomationId="ExportModeBox"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0"
                       Text="{Binding [replay.exportCodec], Source={x:Static i18n:Loc.Source}}"/>
            <ComboBox x:Name="ExportCodecBox" Grid.Column="3" Height="32" VerticalContentAlignment="Center"
                      SelectedIndex="0" AutomationProperties.AutomationId="ExportCodecBox">
                <ComboBoxItem Content="H.264"/>
                <ComboBoxItem Content="HEVC"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                       Text="{Binding [replay.exportPath], Source={x:Static i18n:Loc.Source}}"/>
            <TextBox x:Name="ExportPathBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                     AutomationProperties.AutomationId="ExportPathBox"/>
            <Button x:Name="ExportBrowseButton" Grid.Column="2" Height="32" MinWidth="90" Margin="8,0,0,0"
                    Padding="10,0" VerticalContentAlignment="Center" Click="Browse_Click"
                    AutomationProperties.AutomationId="ExportBrowseButton"
                    Content="{Binding [replay.browse], Source={x:Static i18n:Loc.Source}}"/>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="ExportStatusText" Margin="0,12,0,0" TextWrapping="Wrap"/>

        <Border Grid.Row="4"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ExportStartButton" Height="36" MinWidth="130" Padding="14,0"
                    VerticalContentAlignment="Center" Click="Start_Click"
                    AutomationProperties.AutomationId="ExportStartButton"
                    Content="{Binding [replay.exportStart], Source={x:Static i18n:Loc.Source}}"/>
            <Button x:Name="ExportCloseButton" Height="36" MinWidth="110" Margin="10,0,0,0" Padding="14,0"
                    VerticalContentAlignment="Center" Click="Close_Click"
                    AutomationProperties.AutomationId="ExportCloseButton"
                    Content="{Binding [replay.close], Source={x:Static i18n:Loc.Source}}"/>
        </StackPanel>
    </Grid>
</Window>
