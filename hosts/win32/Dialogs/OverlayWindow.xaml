<Window x:Class="Eiviz.Host.Dialogs.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:preview="clr-namespace:Eiviz.Host.Preview"
        Title="Overlays" Height="720" Width="1400"
        WindowStartupLocation="CenterOwner"
        Background="#2B2B2B" Foreground="#EEEEEE">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Overlays" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Bottom">
                <ComboBox x:Name="AddKindBox" Margin="0,8,0,6" SelectionChanged="AddKind_SelectionChanged">
                    <ComboBoxItem Content="Scene"/>
                    <ComboBoxItem Content="Input"/>
                </ComboBox>
                <ComboBox x:Name="AddSourceBox" Margin="0,0,0,6" DisplayMemberPath="Name"/>
                <Button Content="Add overlay" Height="28" Click="Add_Click"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Z up" Width="72" Click="ZUp_Click"/>
                    <Button Content="Z down" Width="72" Margin="6,0,0,0" Click="ZDown_Click"/>
                    <Button Content="Delete" Width="72" Margin="6,0,0,0" Click="Delete_Click"/>
                </StackPanel>
            </StackPanel>
            <ListBox x:Name="SlotList" Background="#222" Foreground="#EEE" BorderBrush="#444"
                     SelectionChanged="SlotList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="4,2"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
        <DockPanel Grid.Column="1" Margin="12,0">
            <TextBlock x:Name="WireLabel" DockPanel.Dock="Top" Text="Wireframe" FontWeight="Bold" Margin="0,0,0,6"/>
            <Border Background="#111" BorderBrush="#555" BorderThickness="1" ClipToBounds="True">
                <Viewbox Stretch="Uniform" ClipToBounds="True">
                    <Canvas x:Name="WireCanvas" Width="1920" Height="1080" Background="#0A0A0A"
                            ClipToBounds="True"
                            MouseLeftButtonDown="WireCanvas_MouseLeftButtonDown"
                            MouseMove="WireCanvas_MouseMove"
                            MouseLeftButtonUp="WireCanvas_MouseLeftButtonUp"/>
                </Viewbox>
            </Border>
        </DockPanel>
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Live preview" FontWeight="Bold" Margin="0,0,0,6"/>
            <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Source" Margin="0,8,0,0"/>
                    <ComboBox x:Name="SourceKindBox" Margin="0,4,0,6" SelectionChanged="SourceKind_SelectionChanged">
                        <ComboBoxItem Content="Scene"/>
                        <ComboBoxItem Content="Input"/>
                    </ComboBox>
                    <ComboBox x:Name="SourceBox" Margin="0,0,0,8" DisplayMemberPath="Name"
                              SelectionChanged="SourceBox_SelectionChanged"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="PosXLabel" Text="Pos X" VerticalAlignment="Center"/>
                        <TextBox x:Name="XBox" Grid.Column="1" Margin="0,0,8,6" LostFocus="Numeric_LostFocus"/>
                        <TextBlock x:Name="PosYLabel" Grid.Column="3" Text="Pos Y" VerticalAlignment="Center"/>
                        <TextBox x:Name="YBox" Grid.Column="4" Margin="0,0,0,6" LostFocus="Numeric_LostFocus"/>
                        <TextBlock x:Name="SizeXLabel" Grid.Row="1" Text="Size X" VerticalAlignment="Center"/>
                        <TextBox x:Name="WBox" Grid.Row="1" Grid.Column="1" Margin="0,0,4,6" LostFocus="Numeric_LostFocus"/>
                        <CheckBox x:Name="LinkBox" Grid.Row="1" Grid.Column="2"
                                  Content="Link" VerticalAlignment="Center" Margin="0,0,4,6" Foreground="#EEEEEE"
                                  Click="Link_Click"/>
                        <TextBlock x:Name="SizeYLabel" Grid.Row="1" Grid.Column="3" Text="Size Y" VerticalAlignment="Center"/>
                        <TextBox x:Name="HBox" Grid.Row="1" Grid.Column="4" Margin="0,0,0,6" LostFocus="Numeric_LostFocus"/>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Text="Crop" FontWeight="Bold" Margin="0,8,0,2"/>
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="5" Text="px from each edge" FontSize="11" Opacity="0.7" Margin="0,0,0,6"/>
                        <TextBlock x:Name="CropXLabel" Grid.Row="4" Text="Left" VerticalAlignment="Center"/>
                        <TextBox x:Name="CropXBox" Grid.Row="4" Grid.Column="1" Margin="0,0,8,6" LostFocus="Numeric_LostFocus"/>
                        <TextBlock x:Name="CropYLabel" Grid.Row="4" Grid.Column="3" Text="Up" VerticalAlignment="Center"/>
                        <TextBox x:Name="CropYBox" Grid.Row="4" Grid.Column="4" Margin="0,0,0,6" LostFocus="Numeric_LostFocus"/>
                        <TextBlock x:Name="CropWLabel" Grid.Row="5" Text="Right" VerticalAlignment="Center"/>
                        <TextBox x:Name="CropWBox" Grid.Row="5" Grid.Column="1" Margin="0,0,8,6" LostFocus="Numeric_LostFocus"/>
                        <TextBlock x:Name="CropHLabel" Grid.Row="5" Grid.Column="3" Text="Down" VerticalAlignment="Center"/>
                        <TextBox x:Name="CropHBox" Grid.Row="5" Grid.Column="4" Margin="0,0,0,6" LostFocus="Numeric_LostFocus"/>
                        <TextBlock x:Name="OpLabel" Grid.Row="6" Text="Opacity" VerticalAlignment="Center"/>
                        <TextBox x:Name="OpBox" Grid.Row="6" Grid.Column="1" Margin="0,0,8,6" LostFocus="Numeric_LostFocus"/>
                    </Grid>
                    <StackPanel x:Name="MeterHost" Visibility="Collapsed" Margin="0,4,0,8">
                        <TextBlock x:Name="MeterTitle" FontSize="11" Margin="0,0,0,2"/>
                        <Slider x:Name="MeterSlider" Height="18"
                                ValueChanged="MeterSlider_ValueChanged"
                                PreviewMouseLeftButtonUp="MeterSlider_MouseUp"/>
                    </StackPanel>
                    <Button Content="Reset" Height="26" Margin="0,0,0,8" Click="Reset_Click"/>
                    <TextBlock Text="On/Off" Margin="0,8,0,4"/>
                    <ComboBox x:Name="KindBox" Margin="0,0,0,8" SelectionChanged="KindBox_SelectionChanged">
                        <ComboBoxItem Content="Cut" Tag="0"/>
                        <ComboBoxItem Content="Fade" Tag="1"/>
                    </ComboBox>
                    <TextBlock Text="Duration"/>
                    <DockPanel Margin="0,4,0,8">
                        <ComboBox x:Name="DurationUnitBox" DockPanel.Dock="Right" Width="110"
                                  SelectionChanged="DurationUnit_Changed">
                            <ComboBoxItem Content="Frames" Tag="0"/>
                            <ComboBoxItem Content="Milliseconds" Tag="1"/>
                        </ComboBox>
                        <TextBox x:Name="DurationBox" Margin="0,0,8,0" LostFocus="Duration_LostFocus"/>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
            <Border Background="#111" BorderBrush="#555" BorderThickness="1" Margin="0,0,0,12" MinHeight="160">
                <preview:AspectBox x:Name="PreviewAspect" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <preview:SwapchainHost x:Name="PreviewHost"/>
                </preview:AspectBox>
            </Border>
        </DockPanel>
    </Grid>
</Window>
