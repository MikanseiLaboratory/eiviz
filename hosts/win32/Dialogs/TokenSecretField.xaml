<UserControl x:Class="Eiviz.Host.Controls.TokenSecretField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:Eiviz.Host.I18n">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Width="320">
            <PasswordBox x:Name="SecretBox"/>
            <TextBox x:Name="PlainBox" Visibility="Collapsed"/>
        </Grid>
        <Button x:Name="RevealButton" Grid.Column="1" Margin="8,0,0,0" MinWidth="72"
                Content="{Binding [token.reveal], Source={x:Static i18n:Loc.Source}}"
                ToolTip="{Binding [token.revealHint], Source={x:Static i18n:Loc.Source}}"
                Focusable="True"/>
        <Button x:Name="CopyButton" Grid.Column="2" Margin="8,0,0,0" MinWidth="72"
                Content="{Binding [token.copy], Source={x:Static i18n:Loc.Source}}"
                Click="Copy_Click"/>
    </Grid>
</UserControl>
