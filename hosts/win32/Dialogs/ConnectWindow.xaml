<Window x:Class="Eiviz.Host.Dialogs.ConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:Eiviz.Host.I18n"
        Title="{Binding [connect.title], Source={x:Static i18n:Loc.Source}}"
        Height="240" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DialogBackground}" Foreground="{DynamicResource TextForeground}"
        ResizeMode="NoResize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding [dialog.ok], Source={x:Static i18n:Loc.Source}}" Width="88" Height="28" IsDefault="True" Click="Ok_Click"/>
            <Button Content="{Binding [dialog.cancel], Source={x:Static i18n:Loc.Source}}" Width="88" Height="28" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="{Binding [connect.url], Source={x:Static i18n:Loc.Source}}" Margin="0,0,0,4"/>
            <TextBox x:Name="UrlBox" Margin="0,0,0,12"/>
            <TextBlock Text="{Binding [connect.token], Source={x:Static i18n:Loc.Source}}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TokenBox"/>
        </StackPanel>
    </DockPanel>
</Window>
