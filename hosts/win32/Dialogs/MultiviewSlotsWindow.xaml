<Window x:Class="Eiviz.Host.Dialogs.MultiviewSlotsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multiview tiles" Height="520" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#2B2B2B" Foreground="#EEEEEE">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="88" Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="88" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Numbers match Window 1…N. Click a pane to assign that window."/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SlotRows"/>
        </ScrollViewer>
    </DockPanel>
</Window>
