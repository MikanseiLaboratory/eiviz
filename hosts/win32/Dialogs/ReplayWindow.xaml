<Window x:Class="Eiviz.Host.Dialogs.ReplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:Eiviz.Host.I18n"
        xmlns:local="clr-namespace:Eiviz.Host.Dialogs"
        xmlns:preview="clr-namespace:Eiviz.Host.Preview"
        Title="{Binding [replay.windowTitle], Source={x:Static i18n:Loc.Source}}"
        Width="1500" Height="1020" MinWidth="1180" MinHeight="820"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <Style x:Key="DeckList" TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource ListBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
                        <Setter Property="Padding" Value="2,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MonitorBox" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="Background" Value="Black"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0B0B8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <!-- Icons rather than words: an operator reads a transport at a glance, and the
             tooltip carries the name. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="SmallIconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <!-- A camera angle: a number, the way a replay controller labels its cameras. -->
        <Style x:Key="AngleButton" TargetType="Button">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="260"/>
            <RowDefinition Height="3*" MinHeight="240"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: what this deck drives, what it is doing, and the way into the
             recording settings. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="FpsText" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#B0B0B8"/>
                <TextBlock Text="{Binding [replay.recordTc], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="RecordTcText" FontFamily="Consolas" FontSize="20" VerticalAlignment="Center"
                           Foreground="{DynamicResource HudForeground}"/>
                <Button x:Name="CapacityButton" Height="34" MinWidth="170" Margin="16,0,0,0" Click="Capacity_Click"
                        AutomationProperties.AutomationId="CapacityButton"
                        ToolTip="{Binding [replay.capacityIdle], Source={x:Static i18n:Loc.Source}}"
                        Content="{Binding [replay.capacityRun], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="OpenSetupButton" Height="34" MinWidth="170" Margin="16,0,0,0" Click="ReplaySetup_Click"
                        ToolTip="{Binding [replay.openSetupHint], Source={x:Static i18n:Loc.Source}}"
                        Content="{Binding [replay.openSetup], Source={x:Static i18n:Loc.Source}}"/>
            </StackPanel>
            <TextBlock x:Name="CapacityText" DockPanel.Dock="Bottom" Margin="0,0,0,6" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="CapacityText" Foreground="#B0B0B8"/>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding [replay.channel], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center"/>
                <ComboBox x:Name="ChannelBox" Width="130" Height="34" Margin="8,0,0,0" SelectionChanged="ChannelBox_SelectionChanged"/>
                <TextBlock x:Name="StateText" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"/>
            </StackPanel>
        </DockPanel>

        <!-- The two pictures across the top: what the channel sends out, and the angle
             being recorded. A replay controller is watched, so the pictures get the top
             half and the lists get the bottom. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Input on the left, output on the right: where the picture comes from,
                 and what goes out, in the order the eye reads them. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="180"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Left" FontWeight="Bold" VerticalAlignment="Center"
                               Text="{Binding [replay.liveInput], Source={x:Static i18n:Loc.Source}}"/>
                    <!-- The same shape of view the main window calls a multiview: every
                         angle at once, so an operator sees what each camera has. -->
                    <Button x:Name="MultiviewButton" DockPanel.Dock="Right" Height="26" MinWidth="120"
                            HorizontalAlignment="Right" Margin="8,0,0,0" Click="Multiview_Click"
                            ToolTip="{Binding [replay.multiviewHint], Source={x:Static i18n:Loc.Source}}"
                            Content="{Binding [replay.multiview], Source={x:Static i18n:Loc.Source}}"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <!-- The same container the main window uses: the picture keeps its
                         shape and follows the window, instead of being stretched. -->
                    <preview:AspectBox x:Name="LiveBox">
                        <Border Style="{StaticResource MonitorBox}">
                            <preview:SwapchainHost x:Name="LiveMonitor"/>
                        </Border>
                    </preview:AspectBox>
                    <ScrollViewer x:Name="AngleGridScroller" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="AngleGridPanel"/>
                    </ScrollViewer>
                </Grid>
                <TextBlock Grid.Row="2" x:Name="LiveLabel" Style="{StaticResource Caption}"/>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="180"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontWeight="Bold"
                           Text="{Binding [replay.output], Source={x:Static i18n:Loc.Source}}"/>
                <preview:AspectBox Grid.Row="1">
                    <Border Style="{StaticResource MonitorBox}">
                        <preview:SwapchainHost x:Name="OutputMonitor"/>
                    </Border>
                </preview:AspectBox>
                <TextBlock Grid.Row="2" x:Name="OutputLabel" Style="{StaticResource Caption}"/>
            </Grid>
        </Grid>

        <!-- Events and the playlist: one row per item, edited in the row. -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.5*" MinWidth="520"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center"
                               Text="{Binding [replay.events], Source={x:Static i18n:Loc.Source}}"/>
                </DockPanel>
                <ListView x:Name="EventList" Style="{StaticResource DeckList}" SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{Binding [replay.in], Source={x:Static i18n:Loc.Source}}" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding InText}" FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.out], Source={x:Static i18n:Loc.Source}}" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OutText}" FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.duration], Source={x:Static i18n:Loc.Source}}" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DurationText}" FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.name], Source={x:Static i18n:Loc.Source}}" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="24" Margin="2,1" VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.protect], Source={x:Static i18n:Loc.Source}}" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Protected}" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ToolTip="{Binding [replay.protectHint], Source={x:Static i18n:Loc.Source}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE710;"
                                                    Click="EventAddToPlaylist_Click" Tag="{Binding}"
                                                    ToolTip="{Binding [replay.addToPlaylist], Source={x:Static i18n:Loc.Source}}"/>
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE768;"
                                                    Click="EventCue_Click" Tag="{Binding}"
                                                    ToolTip="{Binding [replay.cueHint], Source={x:Static i18n:Loc.Source}}"/>
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE74D;"
                                                    Click="EventDeleteRow_Click" Tag="{Binding}"
                                                    ToolTip="{Binding [replay.delete], Source={x:Static i18n:Loc.Source}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                    </ListView>
                    <!-- An empty list says what to do, rather than showing nothing. -->
                    <TextBlock x:Name="EventEmptyText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Visibility="Collapsed"
                               Text="{Binding [replay.noEvents], Source={x:Static i18n:Loc.Source}}"/>
                </DockPanel>

            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center"
                               Text="{Binding [replay.playlist], Source={x:Static i18n:Loc.Source}}"/>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                        <ComboBox x:Name="PlaylistBox" Width="190" Height="28" DisplayMemberPath="Name"
                                  SelectionChanged="Playlist_Changed"
                                  ToolTip="{Binding [replay.playlistPickHelp], Source={x:Static i18n:Loc.Source}}"/>
                        <TextBox x:Name="PlaylistNameBox" Width="150" Height="28" Margin="6,0,0,0"
                                 LostFocus="PlaylistName_Changed"
                                 ToolTip="{Binding [replay.playlistNameHelp], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="PlaylistAddButton" Width="40" Height="28" Margin="6,0,0,0" Click="PlaylistAdd_Click"
                                FontFamily="Segoe MDL2 Assets" Content="&#xE710;"
                                ToolTip="{Binding [replay.playlistAddHint], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="PlaylistRemoveButton" Width="40" Height="28" Margin="6,0,0,0"
                                Click="PlaylistRemove_Click" FontFamily="Segoe MDL2 Assets" Content="&#xE74D;"
                                ToolTip="{Binding [replay.playlistRemove], Source={x:Static i18n:Loc.Source}}"/>
                        <!-- The whole list from its head: the issue's "smooth playback of
                             several clips" needs a way to start it. -->
                        <Button x:Name="PlaylistPlayButton" Height="28" MinWidth="140" Margin="12,0,0,0"
                                Click="PlaylistPlay_Click"
                                ToolTip="{Binding [replay.playlistPlayHint], Source={x:Static i18n:Loc.Source}}"
                                Content="{Binding [replay.playlistPlay], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="PlaylistStopButton" Width="40" Height="28" Margin="6,0,0,0"
                                Click="PlaylistStop_Click" FontFamily="Segoe MDL2 Assets" Content="&#xE71A;"
                                ToolTip="{Binding [replay.playlistStopHint], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="PlaylistLoopButton" Width="48" Height="28" Margin="6,0,0,0"
                                Click="PlaylistLoop_Click" FontFamily="Segoe MDL2 Assets" Content="&#xE8EE;"
                                ToolTip="{Binding [replay.playlistLoopHint], Source={x:Static i18n:Loc.Source}}"/>
                    </StackPanel>
                </DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="{Binding [replay.defaultTransition], Source={x:Static i18n:Loc.Source}}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="DefaultKindBox" Width="104" Height="26" Margin="0,0,6,0" SelectionChanged="DefaultTransition_Changed">
                        <ComboBoxItem Content="{Binding [replay.transitionCut], Source={x:Static i18n:Loc.Source}}" Tag="Cut" IsSelected="True"/>
                        <ComboBoxItem Content="{Binding [replay.transitionDissolve], Source={x:Static i18n:Loc.Source}}" Tag="Dissolve"/>
                    </ComboBox>
                    <ComboBox x:Name="DefaultTimingBox" Width="140" Height="26" Margin="0,0,6,0" SelectionChanged="DefaultTransition_Changed"
                              ToolTip="{Binding [replay.timingHelp], Source={x:Static i18n:Loc.Source}}">
                        <ComboBoxItem Content="{Binding [replay.timingOverwrap], Source={x:Static i18n:Loc.Source}}" Tag="Overwrap" IsSelected="True"/>
                        <ComboBoxItem Content="{Binding [replay.timingAdditive], Source={x:Static i18n:Loc.Source}}" Tag="Additive"/>
                    </ComboBox>
                    <TextBox x:Name="DefaultFramesBox" Width="56" Height="26" Margin="0,0,6,0" Text="0" LostFocus="DefaultTransition_Changed"/>
                    <TextBlock Text="{Binding [replay.transitionFrames], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center"/>
                </WrapPanel>
                <WrapPanel x:Name="ClipTagPanel" DockPanel.Dock="Bottom" Margin="0,6,0,0"/>
                <ListView x:Name="PlaylistList" Style="{StaticResource DeckList}" SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <!-- Which clip the channel is playing. Empty for the rest, so
                                 the operator can see at a glance what is on air. -->
                            <GridViewColumn Width="26">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Marker}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" Foreground="#7FD14B"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.in], Source={x:Static i18n:Loc.Source}}" Width="96">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding InText}" FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.out], Source={x:Static i18n:Loc.Source}}" Width="96">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OutText}" FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.duration], Source={x:Static i18n:Loc.Source}}" Width="78">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DurationText}" FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.angle], Source={x:Static i18n:Loc.Source}}" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Height="24" Margin="1" DisplayMemberPath="Label"
                                                  ItemsSource="{Binding AngleOptions}" SelectedItem="{Binding AngleOption}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.speed], Source={x:Static i18n:Loc.Source}}" Width="86">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Height="24" Margin="1" DisplayMemberPath="Label"
                                                  ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding SpeedOption}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- One column for the transition: kind, direction and length
                                 belong together, and a clip row is already wide. -->
                            <GridViewColumn Header="{Binding [replay.transition], Source={x:Static i18n:Loc.Source}}" Width="330">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox Width="120" Height="24" Margin="1" DisplayMemberPath="Label"
                                                      ItemsSource="{Binding TransitionOptions}" SelectedItem="{Binding TransitionOption}"
                                                      ToolTip="{Binding [replay.transition], Source={x:Static i18n:Loc.Source}}"/>
                                            <ComboBox Width="104" Height="24" Margin="4,1,1,1" DisplayMemberPath="Label"
                                                      ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding DirectionOption}"
                                                      ToolTip="{Binding [replay.directionHelp], Source={x:Static i18n:Loc.Source}}"/>
                                            <ComboBox Width="96" Height="24" Margin="4,1,1,1" DisplayMemberPath="Label"
                                                      ItemsSource="{Binding TimingOptions}" SelectedItem="{Binding TimingOption}"
                                                      ToolTip="{Binding [replay.timingHelp], Source={x:Static i18n:Loc.Source}}"/>
                                            <TextBox Width="52" Height="24" Margin="4,1,1,1" VerticalContentAlignment="Center"
                                                     Text="{Binding TransitionFrames, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="{Binding [replay.transitionFrames], Source={x:Static i18n:Loc.Source}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.gain], Source={x:Static i18n:Loc.Source}}" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Height="24" Margin="1" VerticalContentAlignment="Center"
                                                 Text="{Binding GainDb, UpdateSourceTrigger=LostFocus}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.preservePitch], Source={x:Static i18n:Loc.Source}}" Width="64">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding PreservePitch}" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ToolTip="{Binding [replay.preservePitch], Source={x:Static i18n:Loc.Source}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.audio], Source={x:Static i18n:Loc.Source}}" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Height="24" Margin="1" DisplayMemberPath="Label"
                                                  ItemsSource="{Binding AudioOptions}" SelectedItem="{Binding AudioOption}"
                                                  ToolTip="{Binding [replay.clipAudioHelp], Source={x:Static i18n:Loc.Source}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.tags], Source={x:Static i18n:Loc.Source}}" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TagsText}" VerticalAlignment="Center" Margin="4,0" Foreground="#B0B0B8"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="112">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE768;"
                                                    Click="ClipCueRow_Click" Tag="{Binding}"
                                                    ToolTip="{Binding [replay.cueHint], Source={x:Static i18n:Loc.Source}}"/>
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE8EC;"
                                                    Click="ClipTagRow_Click" Tag="{Binding}"
                                                    ToolTip="{Binding [tag.add], Source={x:Static i18n:Loc.Source}}"/>
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE74D;"
                                                    Click="ClipDeleteRow_Click" Tag="{Binding}"
                                                    ToolTip="{Binding [replay.remove], Source={x:Static i18n:Loc.Source}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <!-- An empty playlist says how clips get into it. -->
                <TextBlock x:Name="PlaylistEmptyText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Visibility="Collapsed"
                           Text="{Binding [replay.noClips], Source={x:Static i18n:Loc.Source}}"/>
            </DockPanel>
        </Grid>

        <!-- Every operation control at the bottom, in the order an operator works:
             angle, marks, transport, export. -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"
                           Text="{Binding [replay.angles], Source={x:Static i18n:Loc.Source}}"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="AnglePanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </DockPanel>
            <local:ReplayWaveform x:Name="Waveform" Height="52" Margin="0,0,0,8"
                                           AutomationProperties.AutomationId="Waveform"
                                           AutomationProperties.Name="{Binding [replay.waveformSeek], Source={x:Static i18n:Loc.Source}}"
                                           ToolTip="{Binding [replay.waveformSeekHint], Source={x:Static i18n:Loc.Source}}"/>
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="MarkInButton" Width="180" Height="52" FontSize="17" FontWeight="Bold"
                            Click="MarkIn_Click"
                            ToolTip="{Binding [replay.markInHint], Source={x:Static i18n:Loc.Source}}"
                            Content="{Binding [replay.markIn], Source={x:Static i18n:Loc.Source}}"/>
                    <Button x:Name="MarkOutButton" Width="180" Height="52" FontSize="17" FontWeight="Bold" Margin="10,0,0,0"
                            Click="MarkOut_Click"
                            ToolTip="{Binding [replay.markOutHint], Source={x:Static i18n:Loc.Source}}"
                            Content="{Binding [replay.markOut], Source={x:Static i18n:Loc.Source}}"/>
                    <Button x:Name="CancelMarkButton" Width="110" Height="52" Margin="10,0,0,0"
                            Click="CancelMark_Click"
                            ToolTip="{Binding [replay.cancelMarkHint], Source={x:Static i18n:Loc.Source}}"
                            Content="{Binding [replay.cancelMark], Source={x:Static i18n:Loc.Source}}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding [replay.in], Source={x:Static i18n:Loc.Source}}" FontSize="11"/>
                        <TextBlock x:Name="InTcText" FontFamily="Consolas" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding [replay.out], Source={x:Static i18n:Loc.Source}}" FontSize="11"/>
                        <TextBlock x:Name="OutTcText" FontFamily="Consolas" FontSize="18"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding [replay.duration], Source={x:Static i18n:Loc.Source}}" FontSize="11"/>
                        <TextBlock x:Name="DurationTcText" FontFamily="Consolas" FontSize="18"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="RecordButton" Style="{StaticResource IconButton}" Click="RecordToggle_Click"
                        ToolTip="{Binding [replay.recordHint], Source={x:Static i18n:Loc.Source}}">
                    <Ellipse Width="18" Height="18" Fill="#E05252"/>
                </Button>
                <Button x:Name="LiveButton" Style="{StaticResource IconButton}" Content="&#xE8B0;" Click="Live_Click"
                        ToolTip="{Binding [replay.liveHint], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;" Click="Play_Click"
                        ToolTip="{Binding [replay.playHint], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="StepBackButton" Style="{StaticResource IconButton}" Content="&#xE892;" Click="StepBack_Click"
                        ToolTip="{Binding [replay.stepBackHint], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="StepForwardButton" Style="{StaticResource IconButton}" Content="&#xE893;" Click="StepForward_Click"
                        ToolTip="{Binding [replay.stepForwardHint], Source={x:Static i18n:Loc.Source}}"/>
                <Rectangle Width="1" Fill="{DynamicResource ButtonBorder}" Margin="6,4,12,4"/>
                <Button x:Name="Speed25Button" Width="64" Height="44" Margin="0,0,6,0" Click="Speed_Click" Tag="250" Content="25%"
                        ToolTip="{Binding [replay.speedHint], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="Speed50Button" Width="64" Height="44" Margin="0,0,6,0" Click="Speed_Click" Tag="500" Content="50%"
                        ToolTip="{Binding [replay.speedHint], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="Speed75Button" Width="64" Height="44" Margin="0,0,6,0" Click="Speed_Click" Tag="750" Content="75%"
                        ToolTip="{Binding [replay.speedHint], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="Speed100Button" Width="64" Height="44" Margin="0,0,6,0" Click="Speed_Click" Tag="1000" Content="100%"
                        ToolTip="{Binding [replay.speedHint], Source={x:Static i18n:Loc.Source}}"/>
                <TextBlock Text="{Binding [replay.jog], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center" Margin="8,0,8,0"/>
                <Slider x:Name="JogSlider" Width="200" VerticalAlignment="Center" Minimum="-30" Maximum="30" Value="0"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="JogSlider_ValueChanged"
                        ToolTip="{Binding [replay.jogHint], Source={x:Static i18n:Loc.Source}}"/>
            </WrapPanel>

            <!-- Export: the same recordings, written to MP4 with the OS encoder. -->
            <WrapPanel Margin="0,6,0,0">
                <TextBlock Text="{Binding [replay.export], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ExportModeBox" Width="180" Height="28" Margin="0,0,6,0"/>
                <TextBox x:Name="ExportPathBox" Width="300" Height="28" Margin="0,0,6,0"/>
                <Button x:Name="ExportBrowseButton" Width="96" Height="28" Margin="0,0,6,0" Click="ExportBrowse_Click"
                        Content="{Binding [replay.browse], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="ExportButton" Width="110" Height="28" Margin="0,0,6,0" Click="Export_Click"
                        Content="{Binding [replay.exportStart], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="ExportCancelButton" Width="110" Height="28" Margin="0,0,0,0" Click="ExportCancel_Click" IsEnabled="False"
                        Content="{Binding [replay.exportCancel], Source={x:Static i18n:Loc.Source}}"/>
            </WrapPanel>
            <TextBlock x:Name="ExportStatusText" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <!-- The keys an operator works by, on screen: a production tool should not
                 hide its shortcuts in a manual. -->
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#B0B0B8"
                       Text="{Binding [replay.shortcutHelp], Source={x:Static i18n:Loc.Source}}"/>
            <!-- Recording health: where the frames went. -->
            <TextBlock x:Name="HealthText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#B0B0B8"/>
        </StackPanel>
    </Grid>
</Window>
