<Window x:Class="Eiviz.Host.Dialogs.ReplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:Eiviz.Host.I18n"
        xmlns:local="clr-namespace:Eiviz.Host.Dialogs"
        xmlns:preview="clr-namespace:Eiviz.Host.Preview"
        Title="{Binding [replay.windowTitle], Source={x:Static i18n:Loc.Source}}"
        Width="1600" Height="900" MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource WindowBackground}">
    <!-- A replay deck is watched and driven at the same time, so the picture gets the room
         and every other readout is sized to what it actually needs. The layout is three
         bands: the pictures and their transport, the two lists the operator works in, and
         the timeline the marks are set on. It fits a 1280x720 window, which is what the
         smallest laptop a production might run on offers. -->
    <Window.Resources>
        <Style x:Key="DeckList" TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource ListBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
                        <Setter Property="Padding" Value="2,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MonitorBox" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="Background" Value="Black"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0B0B8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <!-- The small uppercase label above a readout. Repeating it on every value is what
             makes a dense deck readable without a legend. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#8A8A94"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
        </Style>
        <!-- A timecode: the one font in the deck that must not shift as the digits change. -->
        <Style x:Key="Timecode" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SpeedButton" TargetType="Button">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SmallIconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- A camera angle: the number is what an operator calls it, the name is what tells
             two of them apart, so the tile carries both. -->
        <Style x:Key="AngleButton" TargetType="Button">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- A heading that names a band of the deck. -->
        <Style x:Key="BandTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#C8C8D0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Header: which channel, what it is doing, and the recording clock. -->
            <RowDefinition Height="Auto"/>
            <!-- The pictures, and the marks that belong with them. -->
            <RowDefinition Height="5*" MinHeight="200"/>
            <!-- The two lists. -->
            <RowDefinition Height="3*" MinHeight="150"/>
            <!-- Timeline, transport and the health line. -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================ header ============================ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding [replay.channel], Source={x:Static i18n:Loc.Source}}"
                           VerticalAlignment="Center" Foreground="#8A8A94" FontSize="11"/>
                <ComboBox x:Name="ChannelBox" Width="120" Height="30" Margin="6,0,0,0"
                          VerticalContentAlignment="Center" SelectionChanged="ChannelBox_SelectionChanged"/>
                <Border Width="1" Background="{DynamicResource ButtonBorder}" Margin="12,4,12,4"/>
                <TextBlock x:Name="StateText" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#24000000" CornerRadius="3" Padding="8,2" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RecordTcLabel" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="#8A8A94" FontSize="11"
                                   Text="{Binding [replay.recordTc], Source={x:Static i18n:Loc.Source}}"/>
                        <TextBlock x:Name="RecordTcText" FontFamily="Consolas" FontSize="18"
                                   VerticalAlignment="Center" Foreground="{DynamicResource HudForeground}"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="FpsText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#8A8A94"/>
                <Button x:Name="CapacityButton" Height="30" MinWidth="150" Click="Capacity_Click"
                        AutomationProperties.AutomationId="CapacityButton"
                        ToolTip="{Binding [replay.capacityIdle], Source={x:Static i18n:Loc.Source}}"
                        Content="{Binding [replay.capacityRun], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="OpenSetupButton" Height="30" MinWidth="150" Margin="6,0,0,0" Click="ReplaySetup_Click"
                        ToolTip="{Binding [replay.openSetupHint], Source={x:Static i18n:Loc.Source}}"
                        Content="{Binding [replay.openSetup], Source={x:Static i18n:Loc.Source}}"/>
            </StackPanel>
            <!-- Where the recordings go and how much room is left: one line, in the middle
                 of the header, because it changes while the show runs. -->
            <TextBlock x:Name="CapacityText" VerticalAlignment="Center" HorizontalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="CapacityText" Foreground="#8A8A94" FontSize="11"/>
        </DockPanel>

        <!-- ============================ pictures ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- What is being recorded. The camera tiles sit under it, where the hand
                 already is, and the multiview takes the same cell when it is on. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <Button x:Name="MultiviewButton" DockPanel.Dock="Right" Height="26" MinWidth="100"
                            Padding="10,0" HorizontalAlignment="Right" Click="Multiview_Click"
                            ToolTip="{Binding [replay.multiviewHint], Source={x:Static i18n:Loc.Source}}"
                            Content="{Binding [replay.multiview], Source={x:Static i18n:Loc.Source}}"/>
                    <TextBlock Style="{StaticResource BandTitle}"
                               Text="{Binding [replay.liveInput], Source={x:Static i18n:Loc.Source}}"/>
                </DockPanel>
                <Grid Grid.Row="1" ClipToBounds="True">
                    <preview:AspectBox x:Name="LiveBox">
                        <Border Style="{StaticResource MonitorBox}">
                            <preview:SwapchainHost x:Name="LiveMonitor"/>
                        </Border>
                    </preview:AspectBox>
                    <ScrollViewer x:Name="AngleGridScroller" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="AngleGridPanel"/>
                    </ScrollViewer>
                </Grid>
                <TextBlock Grid.Row="2" x:Name="LiveLabel" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                    <WrapPanel x:Name="AnglePanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </Grid>

            <!-- What goes out. The status line under it is the channel's own state, so the
                 operator never has to look away from the picture to know if it is playing. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource BandTitle}" Margin="0,0,0,4"
                           Text="{Binding [replay.output], Source={x:Static i18n:Loc.Source}}"/>
                <preview:AspectBox Grid.Row="1">
                    <Border Style="{StaticResource MonitorBox}">
                        <preview:SwapchainHost x:Name="OutputMonitor"/>
                    </Border>
                </preview:AspectBox>
                <TextBlock Grid.Row="2" x:Name="OutputLabel" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
            </Grid>
        </Grid>

        <!-- ============================== lists ============================== -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="360"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.6*" MinWidth="520"/>
            </Grid.ColumnDefinitions>

            <!-- Events: everything the recorder has marked. Narrow on purpose — the playlist
                 is where the show is assembled, so it gets the wider column. -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource BandTitle}"
                               Text="{Binding [replay.events], Source={x:Static i18n:Loc.Source}}"/>
                </DockPanel>
                <TextBlock x:Name="EventEmptyText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                           Visibility="Collapsed"
                           Text="{Binding [replay.noEvents], Source={x:Static i18n:Loc.Source}}"/>
                <ListView x:Name="EventList" Style="{StaticResource DeckList}" SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="EventList"
                          MouseDoubleClick="EventList_MouseDoubleClick"
                          SelectionChanged="EventList_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{Binding [replay.in], Source={x:Static i18n:Loc.Source}}" Width="96">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Name="EventInBox" Text="{Binding InText, Mode=OneWay}" Tag="{Binding}" FontFamily="Consolas"
                                                 Height="24" Margin="2,1" VerticalContentAlignment="Center"
                                                 Loaded="RangeCell_Loaded" LostFocus="RangeCell_LostFocus" KeyDown="RangeCell_KeyDown"
                                                 ToolTip="{Binding [replay.rangeHelp], Source={x:Static i18n:Loc.Source}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.out], Source={x:Static i18n:Loc.Source}}" Width="96">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Name="EventOutBox" Text="{Binding OutText, Mode=OneWay}" Tag="{Binding}" FontFamily="Consolas"
                                                 Height="24" Margin="2,1" VerticalContentAlignment="Center"
                                                 Loaded="RangeCell_Loaded" LostFocus="RangeCell_LostFocus" KeyDown="RangeCell_KeyDown"
                                                 ToolTip="{Binding [replay.rangeHelp], Source={x:Static i18n:Loc.Source}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.duration], Source={x:Static i18n:Loc.Source}}" Width="76">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DurationText}" FontFamily="Consolas"
                                                   VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.name], Source={x:Static i18n:Loc.Source}}" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Name="EventNameBox" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Tag="{Binding}" Height="24" Margin="2,1" VerticalContentAlignment="Center"
                                                 LostFocus="EventNameBox_LostFocus"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="86">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE710;"
                                                    Click="EventAddToPlaylist_Click" Tag="{Binding}"
                                                    ToolTip="{Binding [replay.addToPlaylist], Source={x:Static i18n:Loc.Source}}"/>
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE768;"
                                                    Click="EventCue_Click" Tag="{Binding}"
                                                    ToolTip="{Binding [replay.cueHint], Source={x:Static i18n:Loc.Source}}"/>
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE74D;"
                                                    Click="EventDeleteRow_Click" Tag="{Binding}"
                                                    ToolTip="{Binding [replay.delete], Source={x:Static i18n:Loc.Source}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <!-- Playlist: the show. Only the columns an operator reads while it runs are
                 here; the per-clip settings moved to the editor under the list, which is
                 what let this stop scrolling sideways. -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource BandTitle}" VerticalAlignment="Center"
                               Text="{Binding [replay.playlist], Source={x:Static i18n:Loc.Source}}"/>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                        <ComboBox x:Name="PlaylistBox" Width="160" Height="28" VerticalContentAlignment="Center"
                                  DisplayMemberPath="Name" SelectionChanged="Playlist_Changed"
                                  ToolTip="{Binding [replay.playlistPickHelp], Source={x:Static i18n:Loc.Source}}"/>
                        <TextBox x:Name="PlaylistNameBox" Width="120" Height="28" Margin="4,0,0,0"
                                 VerticalContentAlignment="Center" LostFocus="PlaylistName_Changed"
                                 ToolTip="{Binding [replay.playlistNameHelp], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="PlaylistAddButton" Height="28" MinWidth="40" Margin="4,0,0,0" Padding="8,0"
                                VerticalContentAlignment="Center" Click="PlaylistAdd_Click"
                                ToolTip="{Binding [replay.playlistAddHint], Source={x:Static i18n:Loc.Source}}"
                                Content="{Binding [replay.playlistAdd], Source={x:Static i18n:Loc.Source}}"/>
                        <!-- Whether a new clip joins the end of the list or slots in by its
                             timecode. A show is usually assembled in order; a highlight found
                             late belongs where it happened. -->
                        <ComboBox x:Name="ClipOrderBox" Width="128" Height="28" Margin="4,0,0,0"
                                  VerticalContentAlignment="Center"
                                  AutomationProperties.AutomationId="ClipOrderBox"
                                  ToolTip="{Binding [replay.clipOrderHint], Source={x:Static i18n:Loc.Source}}"
                                  SelectionChanged="ClipOrder_Changed">
                            <ComboBoxItem Content="{Binding [replay.clipOrderAppend], Source={x:Static i18n:Loc.Source}}" Tag="Append" IsSelected="True"/>
                            <ComboBoxItem Content="{Binding [replay.clipOrderTimecode], Source={x:Static i18n:Loc.Source}}" Tag="Timecode"/>
                        </ComboBox>
                        <Button x:Name="PlaylistRemoveButton" Height="28" MinWidth="40" Margin="4,0,0,0" Padding="8,0"
                                VerticalContentAlignment="Center" Click="PlaylistRemove_Click"
                                ToolTip="{Binding [replay.playlistRemove], Source={x:Static i18n:Loc.Source}}"
                                Content="{Binding [replay.playlistRemove], Source={x:Static i18n:Loc.Source}}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PlaylistPlayButton" Height="28" MinWidth="86" Padding="10,0"
                                VerticalContentAlignment="Center" Click="PlaylistPlay_Click"
                                ToolTip="{Binding [replay.playlistPlayHint], Source={x:Static i18n:Loc.Source}}"
                                Content="{Binding [replay.playlistPlay], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="PlaylistPauseButton" Height="28" MinWidth="66" Margin="4,0,0,0" Padding="8,0"
                                VerticalContentAlignment="Center" Click="PlaylistPause_Click"
                                ToolTip="{Binding [replay.pauseHint], Source={x:Static i18n:Loc.Source}}"
                                Content="{Binding [replay.pause], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="PlaylistStopButton" Height="28" MinWidth="52" Margin="4,0,0,0" Padding="8,0"
                                VerticalContentAlignment="Center" Click="PlaylistStop_Click"
                                ToolTip="{Binding [replay.playlistStopHint], Source={x:Static i18n:Loc.Source}}"
                                Content="{Binding [replay.stop], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="PlaylistLoopButton" Height="28" MinWidth="60" Margin="4,0,0,0" Padding="8,0"
                                VerticalContentAlignment="Center" Click="PlaylistLoop_Click"
                                ToolTip="{Binding [replay.playlistLoopHint], Source={x:Static i18n:Loc.Source}}"
                                Content="{Binding [replay.playlistLoop], Source={x:Static i18n:Loc.Source}}"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="PlaylistEmptyText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                           Visibility="Collapsed"
                           Text="{Binding [replay.noClips], Source={x:Static i18n:Loc.Source}}"/>
                <ListView x:Name="PlaylistList" Style="{StaticResource DeckList}" SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="PlaylistList_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <!-- Which clip the channel is playing. -->
                            <GridViewColumn Width="22">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Marker}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10" Foreground="#7FD14B"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.in], Source={x:Static i18n:Loc.Source}}" Width="92">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Name="ClipInBox" Text="{Binding InText, Mode=OneWay}" Tag="{Binding}" FontFamily="Consolas"
                                                 Height="24" Margin="2,1" VerticalContentAlignment="Center"
                                                 Loaded="RangeCell_Loaded" LostFocus="RangeCell_LostFocus" KeyDown="RangeCell_KeyDown"
                                                 ToolTip="{Binding [replay.rangeHelp], Source={x:Static i18n:Loc.Source}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.out], Source={x:Static i18n:Loc.Source}}" Width="92">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Name="ClipOutBox" Text="{Binding OutText, Mode=OneWay}" Tag="{Binding}" FontFamily="Consolas"
                                                 Height="24" Margin="2,1" VerticalContentAlignment="Center"
                                                 Loaded="RangeCell_Loaded" LostFocus="RangeCell_LostFocus" KeyDown="RangeCell_KeyDown"
                                                 ToolTip="{Binding [replay.rangeHelp], Source={x:Static i18n:Loc.Source}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.duration], Source={x:Static i18n:Loc.Source}}" Width="74">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DurationText}" FontFamily="Consolas"
                                                   VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.angle], Source={x:Static i18n:Loc.Source}}" Width="118">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Height="24" Margin="1" DisplayMemberPath="Label"
                                                  ItemsSource="{Binding AngleOptions}" SelectedItem="{Binding AngleOption}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.speed], Source={x:Static i18n:Loc.Source}}" Width="72">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Height="24" Margin="1" DisplayMemberPath="Label"
                                                  ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding SpeedOption}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- A transition is its kind, where it comes from, how long it holds
                                 and whether it overlaps the next clip. Leaving only the kind here
                                 made the other three unreachable. -->
                            <GridViewColumn Header="{Binding [replay.transition], Source={x:Static i18n:Loc.Source}}" Width="330">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox Width="100" Height="24" Margin="1" DisplayMemberPath="Label"
                                                      ItemsSource="{Binding TransitionOptions}" SelectedItem="{Binding TransitionOption}"
                                                      ToolTip="{Binding [replay.transition], Source={x:Static i18n:Loc.Source}}"/>
                                            <ComboBox Width="74" Height="24" Margin="4,1,1,1" DisplayMemberPath="Label"
                                                      Visibility="{Binding DirectionVisibility}"
                                                      ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding DirectionOption}"
                                                      ToolTip="{Binding [replay.directionHelp], Source={x:Static i18n:Loc.Source}}"/>
                                            <ComboBox Width="86" Height="24" Margin="4,1,1,1" DisplayMemberPath="Label"
                                                      ItemsSource="{Binding TimingOptions}" SelectedItem="{Binding TimingOption}"
                                                      ToolTip="{Binding [replay.timingHelp], Source={x:Static i18n:Loc.Source}}"/>
                                            <TextBox Width="42" Height="24" Margin="4,1,1,1" VerticalContentAlignment="Center"
                                                     AutomationProperties.AutomationId="ClipTransitionFrames"
                                                     Visibility="{Binding LengthVisibility}"
                                                     Text="{Binding TransitionFrames, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="{Binding [replay.transitionFrames], Source={x:Static i18n:Loc.Source}}"/>
                                            <TextBlock Text="{Binding [replay.framesShort], Source={x:Static i18n:Loc.Source}}"
                                                       VerticalAlignment="Center" Margin="3,0,0,0" Foreground="#8A8A94"
                                                       Visibility="{Binding LengthVisibility}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{Binding [replay.audioShort], Source={x:Static i18n:Loc.Source}}" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Height="24" Margin="1" DisplayMemberPath="Label"
                                                  ItemsSource="{Binding AudioOptions}" SelectedItem="{Binding AudioOption}"
                                                  ToolTip="{Binding [replay.clipAudioHelp], Source={x:Static i18n:Loc.Source}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="86">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE768;"
                                                    Click="ClipCueRow_Click" Tag="{Binding}"
                                                    ToolTip="{Binding [replay.cueHint], Source={x:Static i18n:Loc.Source}}"/>
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE8EC;"
                                                    Click="ClipTagRow_Click" Tag="{Binding}"
                                                    ToolTip="{Binding [tag.add], Source={x:Static i18n:Loc.Source}}"/>
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE74D;"
                                                    Click="ClipDeleteRow_Click" Tag="{Binding}"
                                                    ToolTip="{Binding [replay.remove], Source={x:Static i18n:Loc.Source}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>

        <!-- ============================ transport ============================ -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <!-- The default transition new clips inherit, and the tag editor for the
                 selected clip: settings that are chosen, not read at a glance. -->
            <DockPanel Margin="0,0,0,6">
                <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="{Binding [replay.defaultTransition], Source={x:Static i18n:Loc.Source}}"
                               VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#8A8A94" FontSize="11"/>
                    <ComboBox x:Name="DefaultKindBox" Width="104" Height="26" Margin="0,0,4,0"
                              VerticalContentAlignment="Center" SelectionChanged="DefaultTransition_Changed">
                        <ComboBoxItem Content="{Binding [replay.transitionCut], Source={x:Static i18n:Loc.Source}}" Tag="Cut" IsSelected="True"/>
                        <ComboBoxItem Content="{Binding [replay.transitionDissolve], Source={x:Static i18n:Loc.Source}}" Tag="Dissolve"/>
                    </ComboBox>
                    <ComboBox x:Name="DefaultTimingBox" Width="130" Height="26" Margin="0,0,4,0"
                              VerticalContentAlignment="Center" SelectionChanged="DefaultTransition_Changed"
                              ToolTip="{Binding [replay.timingHelp], Source={x:Static i18n:Loc.Source}}">
                        <ComboBoxItem Content="{Binding [replay.timingOverwrap], Source={x:Static i18n:Loc.Source}}" Tag="Overwrap" IsSelected="True"/>
                        <ComboBoxItem Content="{Binding [replay.timingAdditive], Source={x:Static i18n:Loc.Source}}" Tag="Additive"/>
                    </ComboBox>
                    <TextBox x:Name="DefaultFramesBox" Width="48" Height="26" Margin="0,0,4,0" Text="0"
                             VerticalContentAlignment="Center" LostFocus="DefaultTransition_Changed"/>
                    <TextBlock Text="{Binding [replay.transitionFrames], Source={x:Static i18n:Loc.Source}}"
                               VerticalAlignment="Center" Foreground="#8A8A94" FontSize="11"/>
                </WrapPanel>
                <WrapPanel x:Name="ClipTagPanel" DockPanel.Dock="Right" Orientation="Horizontal"
                           HorizontalAlignment="Right" Margin="8,0,0,0"/>
            </DockPanel>

            <!-- The whole recording, then the close look around the playhead. -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="RecordingSlider" Grid.Column="0" Height="24" VerticalAlignment="Center"
                        Minimum="0" Maximum="1000" IsSnapToTickEnabled="False"
                        IsMoveToPointEnabled="True"
                        ValueChanged="RecordingSlider_ValueChanged"
                        AutomationProperties.AutomationId="RecordingSlider"
                        AutomationProperties.Name="{Binding [replay.seekWhole], Source={x:Static i18n:Loc.Source}}"
                        ToolTip="{Binding [replay.seekWholeHint], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="JumpLiveButton" Grid.Column="1" Height="26" MinWidth="130" Margin="8,0,0,0"
                        Padding="8,0" Click="JumpLive_Click"
                        AutomationProperties.AutomationId="JumpLiveButton"
                        ToolTip="{Binding [replay.jumpLiveHint], Source={x:Static i18n:Loc.Source}}"
                        Content="{Binding [replay.jumpLive], Source={x:Static i18n:Loc.Source}}"/>
            </Grid>
            <local:ReplayWaveform x:Name="Waveform" Height="48" Margin="0,0,0,6"
                                  AutomationProperties.AutomationId="Waveform"
                                  AutomationProperties.Name="{Binding [replay.waveformSeek], Source={x:Static i18n:Loc.Source}}"
                                  ToolTip="{Binding [replay.waveformSeekHint], Source={x:Static i18n:Loc.Source}}"/>

            <!-- The numbers, on their own line above the controls: where the playhead is,
                 what is left of the clip, what is left of the list, and the clip's range. A
                 single row of controls cannot hold them and the buttons without overlapping,
                 at any width this deck is allowed to have. -->
            <Grid Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="{Binding [replay.playhead], Source={x:Static i18n:Loc.Source}}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="PlayheadTcText" Style="{StaticResource Timecode}" FontSize="18" Foreground="#7FD14B"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="{Binding [replay.remainingInClip], Source={x:Static i18n:Loc.Source}}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="RemainingTcText" Style="{StaticResource Timecode}" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="{Binding [replay.remainingInPlaylist], Source={x:Static i18n:Loc.Source}}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="RemainingPlaylistTcText" Style="{StaticResource Timecode}" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="{Binding [replay.in], Source={x:Static i18n:Loc.Source}}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="InTcText" Style="{StaticResource Timecode}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="{Binding [replay.out], Source={x:Static i18n:Loc.Source}}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="OutTcText" Style="{StaticResource Timecode}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding [replay.duration], Source={x:Static i18n:Loc.Source}}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="DurationTcText" Style="{StaticResource Timecode}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- The controls, in the three groups an operator works through: the recording and
                 its playback, the clips being cut, then the speed they play at and the export. -->
            <Grid Height="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Recording and playback. -->
                <Border Grid.Column="0" Background="#1A1A20" CornerRadius="4" Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RecordButton" Style="{StaticResource TransportButton}" Height="44" Click="RecordToggle_Click"
                                ToolTip="{Binding [replay.recordHint], Source={x:Static i18n:Loc.Source}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="11" Height="11" Fill="#E05252" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [replay.record], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="LiveButton" Style="{StaticResource TransportButton}" Height="44" Click="Live_Click"
                                ToolTip="{Binding [replay.liveHint], Source={x:Static i18n:Loc.Source}}"
                                Content="{Binding [replay.live], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="PlayButton" Style="{StaticResource TransportButton}" Height="44" Click="Play_Click"
                                ToolTip="{Binding [replay.playHint], Source={x:Static i18n:Loc.Source}}"
                                Content="{Binding [replay.play], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="StepBackButton" Style="{StaticResource IconButton}" Height="44" Width="44"
                                Content="&#xE892;" Click="StepBack_Click"
                                ToolTip="{Binding [replay.stepBackHint], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="StepForwardButton" Style="{StaticResource IconButton}" Height="44" Width="44"
                                Content="&#xE893;" Click="StepForward_Click"
                                ToolTip="{Binding [replay.stepForwardHint], Source={x:Static i18n:Loc.Source}}"/>
                    </StackPanel>
                </Border>

                <!-- Marking clips. The "last N seconds" button and its length read as one
                     control: the number sits inside the button's row, not beside it. -->
                <Border Grid.Column="1" Background="#1A1A20" CornerRadius="4" Padding="6,4" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MarkInButton" Width="96" Height="44" FontSize="15" FontWeight="Bold"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="MarkIn_Click"
                                ToolTip="{Binding [replay.markInHint], Source={x:Static i18n:Loc.Source}}"
                                Content="{Binding [replay.markIn], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="MarkOutButton" Width="96" Height="44" FontSize="15" FontWeight="Bold" Margin="4,0,0,0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="MarkOut_Click"
                                ToolTip="{Binding [replay.markOutHint], Source={x:Static i18n:Loc.Source}}"
                                Content="{Binding [replay.markOut], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="CancelMarkButton" Width="72" Height="44" Margin="4,0,0,0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Click="CancelMark_Click"
                                ToolTip="{Binding [replay.cancelMarkHint], Source={x:Static i18n:Loc.Source}}"
                                Content="{Binding [replay.cancelMark], Source={x:Static i18n:Loc.Source}}"/>
                        <Border Width="1" Background="{DynamicResource ButtonBorder}" Margin="8,6,8,6"/>
                        <!-- One control: the length is part of the button's own row, styled to
                             read as a field rather than floating beside it. -->
                        <Border BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1" CornerRadius="3" Height="44">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="MarkLastSecondsBox" Width="44" Margin="6,0,0,0" Text="10"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                         AutomationProperties.AutomationId="MarkLastSecondsBox"
                                         ToolTip="{Binding [replay.markLastSecondsHint], Source={x:Static i18n:Loc.Source}}"/>
                                <TextBlock Text="{Binding [replay.secondsShort], Source={x:Static i18n:Loc.Source}}"
                                           VerticalAlignment="Center" Foreground="#8A8A94" Margin="0,0,6,0"/>
                                <Button x:Name="MarkLastButton" Height="42" MinWidth="0" Padding="10,0"
                                        BorderThickness="0" Background="Transparent"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Click="MarkLast_Click"
                                        AutomationProperties.AutomationId="MarkLastButton"
                                        ToolTip="{Binding [replay.markLastHint], Source={x:Static i18n:Loc.Source}}"
                                        Content="{Binding [replay.markLast], Source={x:Static i18n:Loc.Source}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Speed and export. -->
                <Border Grid.Column="3" Background="#1A1A20" CornerRadius="4" Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="Speed25Button" Style="{StaticResource SpeedButton}" Height="44" Click="Speed_Click" Tag="250" Content="25%"
                                ToolTip="{Binding [replay.speedHint], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="Speed50Button" Style="{StaticResource SpeedButton}" Height="44" Click="Speed_Click" Tag="500" Content="50%"
                                ToolTip="{Binding [replay.speedHint], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="Speed75Button" Style="{StaticResource SpeedButton}" Height="44" Click="Speed_Click" Tag="750" Content="75%"
                                ToolTip="{Binding [replay.speedHint], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="Speed100Button" Style="{StaticResource SpeedButton}" Height="44" Click="Speed_Click" Tag="1000" Content="100%"
                                ToolTip="{Binding [replay.speedHint], Source={x:Static i18n:Loc.Source}}"/>
                        <Slider x:Name="JogSlider" Width="110" Margin="8,0,8,0" VerticalAlignment="Center"
                                Minimum="-30" Maximum="30" Value="0"
                                TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                ValueChanged="JogSlider_ValueChanged"
                                ToolTip="{Binding [replay.jogHint], Source={x:Static i18n:Loc.Source}}"/>
                        <Button x:Name="ExportButton" Height="44" MinWidth="110" Padding="10,0"
                                VerticalContentAlignment="Center" Click="Export_Click"
                                AutomationProperties.AutomationId="ExportButton"
                                ToolTip="{Binding [replay.exportHint], Source={x:Static i18n:Loc.Source}}"
                                Content="{Binding [replay.export], Source={x:Static i18n:Loc.Source}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- One line that says whether the machine is keeping up, and one that names the
                 keys. Both are always there: a production tool should not hide its own state
                 or its shortcuts in a manual. -->            <!-- One line that says whether the machine is keeping up, and one that names the
                 keys. Both are always there: a production tool should not hide its own state
                 or its shortcuts in a manual. -->
            <DockPanel Margin="0,6,0,0">
                <TextBlock x:Name="ExportStatusText" DockPanel.Dock="Right" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="#8A8A94" FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="HealthText" Foreground="#8A8A94" FontSize="11"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Margin="0,2,0,0" TextWrapping="NoWrap" Foreground="#6A6A72" FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding [replay.shortcutHelp], Source={x:Static i18n:Loc.Source}}"/>
        </StackPanel>
    </Grid>
</Window>
