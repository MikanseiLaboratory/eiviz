<Window x:Class="Eiviz.Host.Dialogs.ReplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:Eiviz.Host.I18n"
        xmlns:local="clr-namespace:Eiviz.Host.Dialogs"
        xmlns:preview="clr-namespace:Eiviz.Host.Preview"
        Title="{Binding [replay.windowTitle], Source={x:Static i18n:Loc.Source}}"
        Width="1400" Height="1000" MinWidth="1100" MinHeight="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <Style x:Key="DeckList" TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource ListBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextForeground}"/>
                        <Setter Property="Padding" Value="4,2"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MonitorBox" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="Background" Value="Black"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0B0B8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="240"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: the channel this deck drives, what it is doing, and the way into
             the recording settings. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding [replay.recordTc], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="RecordTcText" FontFamily="Consolas" FontSize="20" VerticalAlignment="Center"
                           Foreground="{DynamicResource HudForeground}"/>
                <Button x:Name="OpenSetupButton" Height="34" MinWidth="170" Margin="16,0,0,0" Click="ReplaySetup_Click"
                        ToolTip="{Binding [replay.openSetupHint], Source={x:Static i18n:Loc.Source}}"
                        Content="{Binding [replay.openSetup], Source={x:Static i18n:Loc.Source}}"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding [replay.channel], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center"/>
                <ComboBox x:Name="ChannelBox" Width="130" Height="34" Margin="8,0,0,0" SelectionChanged="ChannelBox_SelectionChanged"/>
                <TextBlock x:Name="StateText" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="1.15*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- The deck's two pictures: what the channel sends out, and the angle
                 being recorded. They share the column so neither can push the lists
                 off the window. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="220"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="220"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontWeight="Bold"
                           Text="{Binding [replay.output], Source={x:Static i18n:Loc.Source}}"/>
                <Border Grid.Row="1" Style="{StaticResource MonitorBox}">
                    <preview:SwapchainHost x:Name="OutputMonitor"/>
                </Border>
                <TextBlock Grid.Row="2" x:Name="OutputLabel" Style="{StaticResource Caption}"/>
                <TextBlock Grid.Row="3" FontWeight="Bold" Margin="0,8,0,0"
                           Text="{Binding [replay.liveInput], Source={x:Static i18n:Loc.Source}}"/>
                <Border Grid.Row="4" Style="{StaticResource MonitorBox}">
                    <preview:SwapchainHost x:Name="LiveMonitor"/>
                </Border>
                <TextBlock Grid.Row="5" x:Name="LiveLabel" Style="{StaticResource Caption}"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource ButtonBorder}"/>

            <!-- Events and playlist: the two lists an operator works from. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*" MinHeight="150"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock FontWeight="Bold" VerticalAlignment="Center"
                                   Text="{Binding [replay.events], Source={x:Static i18n:Loc.Source}}"/>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="#B0B0B8"
                                   Text="{Binding [replay.eventsRowHelp], Source={x:Static i18n:Loc.Source}}"/>
                    </DockPanel>
                    <!-- Every event is edited in its own row: its name and its protection are
                         cells, so nothing is "select one, then use the buttons above". -->
                    <ListView x:Name="EventList" Style="{StaticResource DeckList}" SelectionMode="Single"
                                  HorizontalContentAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                               FontFamily="Consolas"
                                               Text="{Binding RangeText}"/>
                                    <TextBox Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Grid.Column="2" Margin="8,0,8,0" VerticalAlignment="Center"
                                              IsChecked="{Binding Protected}"
                                              Content="{Binding [replay.protect], Source={x:Static i18n:Loc.Source}}"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button Height="24" Width="70" Click="EventCue_Click" Tag="{Binding}"
                                                ToolTip="{Binding [replay.cueHint], Source={x:Static i18n:Loc.Source}}"
                                                Content="{Binding [replay.cue], Source={x:Static i18n:Loc.Source}}"/>
                                        <Button Height="24" Width="70" Margin="6,0,0,0" Click="EventDeleteRow_Click" Tag="{Binding}"
                                                Content="{Binding [replay.delete], Source={x:Static i18n:Loc.Source}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource ButtonBorder}"/>

                <DockPanel Grid.Row="2">
                    <!-- Which playlist this channel plays, and its name, edited here. A
                         project can hold several (first half, second half, sponsors), and
                         the channel is what points at one. -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock FontWeight="Bold" VerticalAlignment="Center"
                                   Text="{Binding [replay.playlist], Source={x:Static i18n:Loc.Source}}"/>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                            <ComboBox x:Name="PlaylistBox" Width="200" Height="28" DisplayMemberPath="Name"
                                      SelectionChanged="Playlist_Changed"
                                      ToolTip="{Binding [replay.playlistPickHelp], Source={x:Static i18n:Loc.Source}}"/>
                            <TextBox x:Name="PlaylistNameBox" Width="180" Height="28" Margin="6,0,0,0"
                                     LostFocus="PlaylistName_Changed"
                                     ToolTip="{Binding [replay.playlistNameHelp], Source={x:Static i18n:Loc.Source}}"/>
                            <Button x:Name="PlaylistAddButton" Width="90" Height="28" Margin="6,0,0,0" Click="PlaylistAdd_Click"
                                    Content="{Binding [replay.playlistAdd], Source={x:Static i18n:Loc.Source}}"/>
                            <Button x:Name="PlaylistRemoveButton" Width="90" Height="28" Margin="6,0,0,0" Click="PlaylistRemove_Click"
                                    Content="{Binding [replay.playlistRemove], Source={x:Static i18n:Loc.Source}}"/>
                        </StackPanel>
                    </DockPanel>
                    <!-- The clip actions belong to the clip list, not to the playlist row. -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock VerticalAlignment="Center" Foreground="#B0B0B8"
                                   Text="{Binding [replay.clipsHelp], Source={x:Static i18n:Loc.Source}}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ClipCueButton" Width="100" Height="28" Click="ClipCue_Click"
                                    ToolTip="{Binding [replay.cueHint], Source={x:Static i18n:Loc.Source}}"
                                    Content="{Binding [replay.cue], Source={x:Static i18n:Loc.Source}}"/>
                            <Button x:Name="ClipRemoveButton" Width="100" Height="28" Margin="8,0,0,0" Click="ClipRemove_Click"
                                    Content="{Binding [replay.remove], Source={x:Static i18n:Loc.Source}}"/>
                        </StackPanel>
                    </DockPanel>
                    <!-- Playlist default, then the selected clip's editors. Both wrap so
                         a narrow window stacks them instead of clipping them. -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="{Binding [replay.defaultTransition], Source={x:Static i18n:Loc.Source}}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="DefaultKindBox" Width="104" Margin="0,0,6,0" SelectionChanged="DefaultTransition_Changed">
                            <ComboBoxItem Content="{Binding [replay.transitionCut], Source={x:Static i18n:Loc.Source}}" Tag="Cut" IsSelected="True"/>
                            <ComboBoxItem Content="{Binding [replay.transitionDissolve], Source={x:Static i18n:Loc.Source}}" Tag="Dissolve"/>
                        </ComboBox>
                        <ComboBox x:Name="DefaultTimingBox" Width="150" Margin="0,0,6,0" SelectionChanged="DefaultTransition_Changed"
                                  ToolTip="{Binding [replay.timingHelp], Source={x:Static i18n:Loc.Source}}">
                            <ComboBoxItem Content="{Binding [replay.timingOverwrap], Source={x:Static i18n:Loc.Source}}" Tag="Overwrap" IsSelected="True"/>
                            <ComboBoxItem Content="{Binding [replay.timingAdditive], Source={x:Static i18n:Loc.Source}}" Tag="Additive"/>
                        </ComboBox>
                        <TextBox x:Name="DefaultFramesBox" Width="60" Margin="0,0,6,0" Text="0" LostFocus="DefaultTransition_Changed"/>
                        <TextBlock Text="{Binding [replay.transitionFrames], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <!-- Tags for the clip whose + button was pressed. The rows show them; this
                         strip is where they are ticked. -->
                    <WrapPanel x:Name="ClipTagPanel" DockPanel.Dock="Bottom" Margin="0,6,0,0"/>
                    <!-- Each clip is edited in its own row: angle, speed, transition, length,
                         gain, pitch and audio are cells, so nothing is "select a clip, then
                         use the controls below". -->
                    <ListView x:Name="PlaylistList" Style="{StaticResource DeckList}" SelectionMode="Single"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,10,4" FontFamily="Consolas"
                                                   Text="{Binding RangeText}"/>
                                        <ComboBox Width="150" Height="24" DisplayMemberPath="Label"
                                                  ItemsSource="{Binding AngleOptions}" SelectedItem="{Binding AngleOption}"
                                                  ToolTip="{Binding [replay.angle], Source={x:Static i18n:Loc.Source}}"/>
                                        <ComboBox Width="90" Height="24" Margin="6,0,0,0" DisplayMemberPath="Label"
                                                  ItemsSource="{Binding SpeedOptions}" SelectedItem="{Binding SpeedOption}"
                                                  ToolTip="{Binding [replay.speed], Source={x:Static i18n:Loc.Source}}"/>
                                        <Button Width="80" Height="24" Margin="10,0,0,0" Click="ClipCueRow_Click" Tag="{Binding}"
                                                ToolTip="{Binding [replay.cueHint], Source={x:Static i18n:Loc.Source}}"
                                                Content="{Binding [replay.cue], Source={x:Static i18n:Loc.Source}}"/>
                                        <Button Width="80" Height="24" Margin="6,0,0,0" Click="ClipDeleteRow_Click" Tag="{Binding}"
                                                Content="{Binding [replay.remove], Source={x:Static i18n:Loc.Source}}"/>
                                        <Button Width="90" Height="24" Margin="6,0,0,0" Click="ClipTagRow_Click" Tag="{Binding}"
                                                Content="{Binding [tag.add], Source={x:Static i18n:Loc.Source}}"/>
                                    </WrapPanel>
                                    <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <ComboBox Width="104" Height="24" DisplayMemberPath="Label"
                                                  ItemsSource="{Binding TransitionOptions}" SelectedItem="{Binding TransitionOption}"
                                                  ToolTip="{Binding [replay.transition], Source={x:Static i18n:Loc.Source}}"/>
                                        <ComboBox Width="140" Height="24" Margin="6,0,0,0" DisplayMemberPath="Label"
                                                  ItemsSource="{Binding TimingOptions}" SelectedItem="{Binding TimingOption}"
                                                  ToolTip="{Binding [replay.timingHelp], Source={x:Static i18n:Loc.Source}}"/>
                                        <TextBox Width="56" Height="24" Margin="6,0,0,0" VerticalContentAlignment="Center"
                                                 Text="{Binding TransitionFrames, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="{Binding [replay.transitionFrames], Source={x:Static i18n:Loc.Source}}"/>
                                        <TextBlock Text="{Binding [replay.gain], Source={x:Static i18n:Loc.Source}}"
                                                   VerticalAlignment="Center" Margin="10,0,4,0"/>
                                        <TextBox Width="52" Height="24" VerticalContentAlignment="Center"
                                                 Text="{Binding GainDb, UpdateSourceTrigger=LostFocus}"/>
                                        <CheckBox Margin="10,0,0,0" VerticalAlignment="Center"
                                                  IsChecked="{Binding PreservePitch}"
                                                  Content="{Binding [replay.preservePitch], Source={x:Static i18n:Loc.Source}}"/>
                                        <ComboBox Width="150" Height="24" Margin="10,0,0,0" DisplayMemberPath="Label"
                                                  ItemsSource="{Binding AudioOptions}" SelectedItem="{Binding AudioOption}"
                                                  ToolTip="{Binding [replay.clipAudioHelp], Source={x:Static i18n:Loc.Source}}"/>
                                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#B0B0B8"
                                                   Text="{Binding TagsText}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Angles: every camera being recorded. Click one to choose the angle the
             mark and the playlist use. -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock FontWeight="Bold" VerticalAlignment="Center"
                           Text="{Binding [replay.angles], Source={x:Static i18n:Loc.Source}}"/>
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#B0B0B8"
                           Text="{Binding [replay.anglesHelpShort], Source={x:Static i18n:Loc.Source}}"/>
            </DockPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="128">
                <WrapPanel x:Name="AnglePanel" Orientation="Horizontal"/>
            </ScrollViewer>
        </DockPanel>

        <!-- Deck controls: marks first, then transport, then export and health. -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <local:ReplayWaveform x:Name="Waveform" Height="56" Margin="0,0,0,8"/>
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="MarkInButton" Width="190" Height="56" FontSize="18" FontWeight="Bold"
                            Click="MarkIn_Click"
                            ToolTip="{Binding [replay.markInHint], Source={x:Static i18n:Loc.Source}}"
                            Content="{Binding [replay.markIn], Source={x:Static i18n:Loc.Source}}"/>
                    <Button x:Name="MarkOutButton" Width="190" Height="56" FontSize="18" FontWeight="Bold" Margin="10,0,0,0"
                            Click="MarkOut_Click"
                            ToolTip="{Binding [replay.markOutHint], Source={x:Static i18n:Loc.Source}}"
                            Content="{Binding [replay.markOut], Source={x:Static i18n:Loc.Source}}"/>
                    <Button x:Name="CancelMarkButton" Width="120" Height="56" Margin="10,0,0,0"
                            Click="CancelMark_Click"
                            Content="{Binding [replay.cancelMark], Source={x:Static i18n:Loc.Source}}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding [replay.in], Source={x:Static i18n:Loc.Source}}" FontSize="11"/>
                        <TextBlock x:Name="InTcText" FontFamily="Consolas" FontSize="18"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding [replay.out], Source={x:Static i18n:Loc.Source}}" FontSize="11"/>
                        <TextBlock x:Name="OutTcText" FontFamily="Consolas" FontSize="18"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding [replay.duration], Source={x:Static i18n:Loc.Source}}" FontSize="11"/>
                        <TextBlock x:Name="DurationTcText" FontFamily="Consolas" FontSize="18"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="RecordButton" Width="130" Height="44" Margin="0,0,8,6" Click="Record_Click"
                        ToolTip="{Binding [replay.recordHint], Source={x:Static i18n:Loc.Source}}"
                        Content="{Binding [replay.record], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="StopButton" Width="130" Height="44" Margin="0,0,8,6" Click="Stop_Click"
                        ToolTip="{Binding [replay.stopHint], Source={x:Static i18n:Loc.Source}}"
                        Content="{Binding [replay.stop], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="LiveButton" Width="130" Height="44" Margin="0,0,8,6" Click="Live_Click"
                        ToolTip="{Binding [replay.liveHint], Source={x:Static i18n:Loc.Source}}"
                        Content="{Binding [replay.live], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="PlayButton" Width="130" Height="44" Margin="0,0,8,6" Click="Play_Click"
                        ToolTip="{Binding [replay.playHint], Source={x:Static i18n:Loc.Source}}"
                        Content="{Binding [replay.play], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="StepBackButton" Width="96" Height="44" Margin="0,0,8,6" Click="StepBack_Click"
                        ToolTip="{Binding [replay.stepBackHint], Source={x:Static i18n:Loc.Source}}"
                        Content="{Binding [replay.stepBack], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="StepForwardButton" Width="96" Height="44" Margin="0,0,8,6" Click="StepForward_Click"
                        ToolTip="{Binding [replay.stepForwardHint], Source={x:Static i18n:Loc.Source}}"
                        Content="{Binding [replay.stepForward], Source={x:Static i18n:Loc.Source}}"/>
                <Button Width="96" Height="44" Margin="0,0,8,6" Click="Speed_Click" Tag="250" Content="25%"
                        ToolTip="{Binding [replay.speedHint], Source={x:Static i18n:Loc.Source}}"/>
                <Button Width="96" Height="44" Margin="0,0,8,6" Click="Speed_Click" Tag="500" Content="50%"
                        ToolTip="{Binding [replay.speedHint], Source={x:Static i18n:Loc.Source}}"/>
                <Button Width="96" Height="44" Margin="0,0,8,6" Click="Speed_Click" Tag="1000" Content="100%"
                        ToolTip="{Binding [replay.speedHint], Source={x:Static i18n:Loc.Source}}"/>
                <TextBlock Text="{Binding [replay.jog], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center" Margin="8,0,8,6"/>
                <Slider x:Name="JogSlider" Width="220" Margin="0,0,0,6" Minimum="-30" Maximum="30" Value="0"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="JogSlider_ValueChanged"
                        ToolTip="{Binding [replay.jogHint], Source={x:Static i18n:Loc.Source}}"/>
            </WrapPanel>

            <!-- Export: the same recordings, written to MP4 with the OS encoder. -->
            <WrapPanel Margin="0,4,0,0">
                <TextBlock Text="{Binding [replay.export], Source={x:Static i18n:Loc.Source}}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ExportModeBox" Width="180" Height="28" Margin="0,0,6,0"/>
                <TextBox x:Name="ExportPathBox" Width="320" Height="28" Margin="0,0,6,0"/>
                <Button x:Name="ExportBrowseButton" Width="96" Height="28" Margin="0,0,6,0" Click="ExportBrowse_Click"
                        Content="{Binding [replay.browse], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="ExportButton" Width="110" Height="28" Margin="0,0,6,0" Click="Export_Click"
                        Content="{Binding [replay.exportStart], Source={x:Static i18n:Loc.Source}}"/>
                <Button x:Name="ExportCancelButton" Width="110" Height="28" Margin="0,0,0,0" Click="ExportCancel_Click" IsEnabled="False"
                        Content="{Binding [replay.exportCancel], Source={x:Static i18n:Loc.Source}}"/>
            </WrapPanel>
            <TextBlock x:Name="ExportStatusText" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <!-- Recording health: where the frames went. -->
            <TextBlock x:Name="HealthText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#B0B0B8"/>
        </StackPanel>
    </Grid>
</Window>
